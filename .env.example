PORT=3000
SESSION_SECRET=your_session_secret_here
PUBLIC_APP_ORIGIN=https://copyquick.example

# Optional local SQLite override. Leave unset to use db/copyquick.db.
DATABASE_PATH=

# Production persistent-storage configuration:
# DATABASE_PATH=/var/data/copyquick.db
# PERSISTENT_DATA_DIR=/var/data

# Optional backup overrides. Production defaults to $PERSISTENT_DATA_DIR/backups.
DATABASE_BACKUP_DIR=
DATABASE_BACKUP_RETENTION=7
# DATABASE_BACKUP_MAX_AGE_HOURS=36
# Bound expensive SQLite verification to the newest local snapshots.
# DATABASE_BACKUP_HEALTH_VERIFY_LIMIT=10
# Bound local backup directory inspection and cleanup work per run.
# DATABASE_BACKUP_MAX_DIRECTORY_ENTRIES=10000
# DATABASE_BACKUP_RETENTION_DELETE_LIMIT=100

# Encrypted S3-compatible off-site backups (disabled by default).
OFFSITE_BACKUP_ENABLED=false
# Automatic scheduling also requires OFFSITE_BACKUP_ENABLED=true.
OFFSITE_BACKUP_SCHEDULE_ENABLED=false
OFFSITE_BACKUP_INTERVAL_HOURS=24
# Operational backup/storage alerts (disabled by default).
BACKUP_HEALTH_ALERTS_ENABLED=false
BACKUP_ALERT_EMAIL=
BACKUP_ALERT_REMINDER_HOURS=24
BACKUP_RECOVERY_NOTIFICATIONS_ENABLED=true
OFFSITE_BACKUP_ENDPOINT=
OFFSITE_BACKUP_REGION=
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
OFFSITE_BACKUP_PREFIX=copyquick/production
# Base64 encoding of exactly 32 cryptographically random bytes.
OFFSITE_BACKUP_ENCRYPTION_KEY=
OFFSITE_BACKUP_KEY_ID=v1
OFFSITE_BACKUP_RETENTION=30
# Bound best-effort remote retention deletes performed by one backup run.
# OFFSITE_BACKUP_RETENTION_DELETE_LIMIT=100
OFFSITE_BACKUP_MAX_AGE_HOURS=36
# 64 MiB default bounds current in-memory encryption to roughly 320 MiB peak.
OFFSITE_BACKUP_MAX_ARTIFACT_BYTES=67108864
# Bound R2/S3 connection setup, each request attempt, and SDK attempts.
# OFFSITE_STORAGE_CONNECTION_TIMEOUT_MS=5000
# OFFSITE_STORAGE_REQUEST_TIMEOUT_MS=120000
# OFFSITE_STORAGE_MAX_ATTEMPTS=3
# OFFSITE_STORAGE_MAX_LISTED_OBJECTS=10000
# Restore-only overrides for an older retained key; do not put keys in CLI arguments.
OFFSITE_BACKUP_DECRYPTION_KEY=
OFFSITE_BACKUP_DECRYPTION_KEY_ID=

# Optional storage warnings (defaults: warning at 1 GiB/20%, critical at 512 MiB/10%).
# DATABASE_STORAGE_WARNING_FREE_BYTES=1073741824
# DATABASE_STORAGE_CRITICAL_FREE_BYTES=536870912
# DATABASE_STORAGE_WARNING_FREE_PERCENT=20
# DATABASE_STORAGE_CRITICAL_FREE_PERCENT=10
STRIPE_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE=price_...
STRIPE_UNLIMITED_PRICE=price_...
# Bound each Stripe API attempt and SDK-managed network retry count.
# STRIPE_API_TIMEOUT_MS=20000
# STRIPE_API_MAX_NETWORK_RETRIES=1
STRIPE_RECONCILIATION_ENABLED=false
STRIPE_RECONCILIATION_INTERVAL_HOURS=24
# Bound one complete reconciliation inventory before any entitlement repair.
# STRIPE_RECONCILIATION_MAX_DURATION_MS=300000
STRIPE_PAST_DUE_GRACE_HOURS=72
RESEND_API_KEY=re_... your Resend API key
# EMAIL_DELIVERY_MAX_ATTEMPTS=3
# EMAIL_DELIVERY_RETRY_BASE_MS=250
# EMAIL_DELIVERY_TIMEOUT_MS=10000
# EMAIL_DELIVERY_TOTAL_TIMEOUT_MS=35000
# Bound the complete contact admin + optional visitor-confirmation workflow.
# CONTACT_EMAIL_TOTAL_TIMEOUT_MS=40000
# Graceful shutdown waits for password-reset delivery after active requests finish.
# EMAIL_DELIVERY_DRAIN_TIMEOUT_MS=15000

# Stop accepting HTTP requests immediately on shutdown, then bound active-request drain.
# HTTP_SHUTDOWN_TIMEOUT_MS=25000

# Provider-neutral generation safety bounds. These do not enable a live AI provider.
# Use `acceptance` for localhost/browser acceptance. It forces deterministic
# production even if the protected local environment enables OpenAI.
COPYQUICK_EXECUTION_MODE=standard
AI_PROVIDER=deterministic
# To enable real OpenAI production output, change AI_PROVIDER to openai and
# supply the key through the protected runtime environment. Never commit a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DISCOVERY_ENABLED=false
AI_STRATEGY_ENABLED=false
# Use a long, random deployment secret to pseudonymize end-user identifiers.
AI_SAFETY_IDENTIFIER_SECRET=
AI_PROVIDER_MAX_REVISIONS=1
AI_PROVIDER_TIMEOUT_MS=45000
AI_PROVIDER_MAX_CONCURRENCY=2
AI_PROVIDER_MAX_INPUT_BYTES=32768
AI_PROVIDER_MAX_OUTPUT_BYTES=262144

# Production worker cycle safety bounds.
# PRODUCTION_MAX_CONCURRENCY=1
# PRODUCTION_RECOVERY_SCAN_LIMIT=100

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://copyquick.co/auth/google/callback
