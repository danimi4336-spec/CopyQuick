<div class="discovery-page">
    <div class="container discovery-container">
        <section class="discovery-card" aria-labelledby="discovery-title">
            <div class="discovery-progress">
                <span>Understanding your business...</span>
            </div>

            <% if (discoverySession && discoverySession.offerSelectionPending) { %>
                <header class="discovery-header">
                    <h1 id="discovery-title">Which offer is this objective about?</h1>
                    <p>Choose what you want to work on so CopyQuick can reuse the right business context.</p>
                </header>
                <% if (error) { %><div class="alert alert-error discovery-error" role="alert"><%= error %></div><% } %>
                <form action="/discovery" method="POST" class="discovery-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="questionId" value="offer_subject_selection">
                    <fieldset class="discovery-question-fieldset"><legend>Remembered offers</legend><div class="discovery-choice-grid">
                    <% discoverySession.rememberedOffers.forEach(function(offer) { %><label class="discovery-choice"><input type="radio" name="offerSubjectId" value="<%= offer.id %>" required><span><%= offer.displayLabel %></span></label><% }); %>
                    <label class="discovery-choice"><input type="radio" name="offerSubjectId" value="new" required><span>A different or new offer</span></label>
                    </div></fieldset>
                    <div class="discovery-actions"><a href="/welcome" class="btn btn-outline btn-lg">← Back</a><button type="submit" class="btn btn-primary btn-lg">Continue <span aria-hidden="true">→</span></button></div>
                </form>
            <% } else if (editingInitialDescription || !discoverySession || !Array.isArray(discoverySession.completedQuestions) || !discoverySession.completedQuestions.includes('initial_description')) { %>
                <header class="discovery-header">
                    <h1 id="discovery-title">Let's Build Something Amazing</h1>
                    <p>We'll begin with what you know today, then adapt the conversation as we learn about your business. You can keep your answer simple—we'll help bring the important details into focus.</p>
                </header>

                <% if (error) { %><div class="alert alert-error discovery-error" role="alert"><%= error %></div><% } %>

                <form action="/discovery" method="POST" class="discovery-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="questionId" value="initial_description">
                    <div class="form-group">
                        <label for="whatBuilding"><%= initialPrompt %></label>
                        <textarea id="whatBuilding" name="whatBuilding" rows="5" maxlength="2000" placeholder="<%= initialPlaceholder %>" required autofocus><%= answer %></textarea>
                    </div>

                    <div class="discovery-examples" aria-labelledby="discovery-examples-label">
                        <span id="discovery-examples-label">For example:</span>
                        <div class="discovery-example-list">
                            <% examplePrompts.forEach(function(prompt) { %>
                                <button type="button" class="discovery-example" data-example="<%= prompt %>"><%= prompt %></button>
                            <% }); %>
                        </div>
                    </div>

                    <div class="discovery-actions">
                        <a href="/welcome" class="btn btn-outline btn-lg">← Back</a>
                        <button type="submit" class="btn btn-primary btn-lg">Continue <span aria-hidden="true">→</span></button>
                    </div>
                </form>
            <% } else { %>
                <header class="discovery-header discovery-state-header">
                    <h1 id="discovery-title">Here’s what I understand so far</h1>
                    <p class="discovery-original-answer">“<%= discoverySession.answers.initial_description %>”</p>
                </header>
                <% if (discoverySession.memoryContext) { %><div class="alert alert-info" role="status">Using what CopyQuick remembers about <strong><%= discoverySession.memoryContext.offerLabel %></strong>. You do not need to explain it again.</div><% } %>

                <% if (understandingSummary.length) { %>
                    <ul class="discovery-understanding-list" aria-label="Business understanding">
                        <% understandingSummary.forEach(function(field) { %>
                            <li><span aria-hidden="true"><%= field.value === 'unsure' ? '?' : '✓' %></span><%= field.label %></li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p class="discovery-conservative-note">I’m keeping the details open until I know enough to make a reliable conclusion.</p>
                <% } %>

                <% if (error) { %><div class="alert alert-error discovery-error" role="alert"><%= error %></div><% } %>

                <% if (nextQuestion) { %>
                    <form action="/discovery" method="POST" class="discovery-form discovery-question-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="questionId" value="<%= nextQuestion.id %>">
                        <fieldset class="discovery-question-fieldset">
                            <legend><%= nextQuestion.prompt %></legend>
                            <p><%= nextQuestion.explanation %></p>
                            <% if (nextQuestion.type === 'free_text') { %>
                                <textarea name="freeTextAnswer" rows="5" maxlength="2000" placeholder="<%= nextQuestion.placeholder || '' %>"><%= otherAnswer %></textarea>
                                <% if (nextQuestion.allowsUnsure) { %>
                                    <label class="discovery-choice discovery-unsure-choice">
                                        <input type="checkbox" name="unsure" value="unsure">
                                        <span>I’m not sure yet</span>
                                    </label>
                                <% } %>
                            <% } else { %>
                            <div class="discovery-choice-grid">
                                <% nextQuestion.options.forEach(function(option) { %>
                                    <label class="discovery-choice">
                                        <% if (nextQuestion.type === 'multi_choice') { %>
                                            <input type="checkbox" name="choices" value="<%= option.value %>" <%= selectedChoices.includes(option.value) ? 'checked' : '' %>>
                                        <% } else { %>
                                            <input type="radio" name="choice" value="<%= option.value %>" <%= selectedChoice === option.value ? 'checked' : '' %> required>
                                        <% } %>
                                        <span><%= option.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                            <% } %>
                        </fieldset>

                        <% if (nextQuestion.allowsAdditionalDetail) { %>
                            <div class="form-group">
                                <label for="additionalDetail">Anything else you want this product to have or do?</label>
                                <p class="discovery-additional-detail-helper">Tell us about ingredients, format, special characteristics, or anything else you have in mind.</p>
                                <textarea id="additionalDetail" name="additionalDetail" rows="3" maxlength="2000" placeholder="Tell us anything else you want CopyQuick to explore."><%= additionalDetail %></textarea>
                            </div>
                        <% } %>

                        <% if (nextQuestion.type !== 'free_text') { %><div class="form-group discovery-other-field <%= selectedChoice === 'other' ? 'visible' : '' %>" id="discoveryOtherField">
                            <label for="otherAnswer">Tell us more</label>
                            <input type="text" id="otherAnswer" name="otherAnswer" maxlength="2000" value="<%= otherAnswer %>">
                        </div><% } %>

                        <div class="discovery-actions">
                            <button type="submit" class="btn btn-outline btn-lg" formaction="/discovery/back" formmethod="POST" formnovalidate>← Back</button>
                            <button type="submit" class="btn btn-primary btn-lg">Continue <span aria-hidden="true">→</span></button>
                        </div>
                    </form>
                <% } else { %>
                    <div class="discovery-foundation-ready">
                        <% if (discoverySession.planningReadiness && discoverySession.planningReadiness.ready) { %>
                            <h2>We have a strong foundation.</h2>
                            <p>Your discovery answers are saved and ready for the next stage.</p>
                        <% } else { %>
                            <h2>We have captured what you know today.</h2>
                            <p>Important uncertainty will stay visible instead of being turned into assumptions.</p>
                        <% } %>
                    </div>
                <% } %>
            <% } %>
        </section>
    </div>
</div>

<script>
(function(){
  var initialInput = document.getElementById('whatBuilding');
  if (initialInput) {
    document.querySelectorAll('.discovery-example').forEach(function(example){
      example.addEventListener('click', function(){
        initialInput.value = example.getAttribute('data-example') || '';
        initialInput.focus();
      });
    });
  }

  var otherField = document.getElementById('discoveryOtherField');
  var otherInput = document.getElementById('otherAnswer');
  var choices = document.querySelectorAll('input[name="choice"]');
  function updateOtherField() {
    if (!otherField || !otherInput) return;
    var selected = document.querySelector('input[name="choice"]:checked');
    var showOther = selected && selected.value === 'other';
    otherField.classList.toggle('visible', showOther);
    otherInput.required = Boolean(showOther);
    if (!showOther) otherInput.value = '';
  }
  choices.forEach(function(choice){ choice.addEventListener('change', updateOtherField); });
  updateOtherField();

  var multiChoices = document.querySelectorAll('input[name="choices"]');
  multiChoices.forEach(function(choice) {
    choice.addEventListener('change', function() {
      if (!choice.checked) return;
      if (choice.value === 'unsure') {
        multiChoices.forEach(function(other) { if (other !== choice) other.checked = false; });
      } else {
        var unsure = document.querySelector('input[name="choices"][value="unsure"]');
        if (unsure) unsure.checked = false;
      }
    });
  });
})();
</script>
