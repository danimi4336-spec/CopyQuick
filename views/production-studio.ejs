<% if (typeof delivery === 'undefined') { const legacyJobs = typeof phases !== 'undefined' ? phases.flatMap(function(phase) { return phase.jobs || []; }) : (production.jobs || []); const legacyReady = legacyJobs.filter(function(job) { return job.artifactPolicy?.role === 'ready_to_use_asset'; }); const legacyPlanning = legacyJobs.filter(function(job) { return job.artifactPolicy?.role !== 'ready_to_use_asset'; }); delivery = { readyForReview: legacyReady, needsAttention: [], researchSources: [], strategyPlanning: legacyPlanning, recommended: legacyReady[0] || null, supportingCount: legacyPlanning.length, terminal: false }; } %>
<div class="production-studio-page">
    <div class="container production-studio-container">
        <header class="production-studio-header">
            <span class="build-plan-eyebrow">Production Studio</span>
            <h1><%= typeof planName !== 'undefined' ? planName : 'Production Plan' %></h1>
            <% if (delivery.terminal) { %>
                <h2 class="production-delivery-title"><%= delivery.readyForReview.length ? 'Your work is ready for review' : delivery.needsAttention.length ? 'Your work needs attention' : 'Your supporting work is available' %></h2>
                <p><strong><%= delivery.readyForReview.length %> asset<%= delivery.readyForReview.length === 1 ? '' : 's' %> ready for review</strong> · <%= delivery.supportingCount %> supporting document<%= delivery.supportingCount === 1 ? '' : 's' %> · <%= delivery.needsAttention.length ? delivery.needsAttention.length + ' item' + (delivery.needsAttention.length === 1 ? '' : 's') + ' need attention' : 'no items need attention' %></p>
                <% if (delivery.recommended && delivery.recommended.generation_id) { %><a class="btn btn-primary production-hero-action" href="/generation/<%= delivery.recommended.generation_id %>"><%= delivery.recommended.readiness === 'READY_FOR_REVIEW' ? 'Open' : 'Review' %> <%= delivery.recommended.title %></a><% } %>
            <% } else { %><p><strong id="production-progress">Creating your assets · <%= completedCount %> of <%= production.jobs.length %> complete</strong></p><% } %>
        </header>

        <% if (executionNotice) { %><div class="alert production-execution-notice" role="status"><%= executionNotice %></div><% } %>
        <% if (production.objective === 'build_brand' && production.status === 'completed') { %><p><a class="btn btn-primary" href="/brand-brain?fromRun=<%= production.id %>">Review decisions for Brand Brain</a></p><% } %>
        <p id="production-live-status" class="production-live-status" role="status" aria-live="polite"></p>

        <section class="production-run-summary production-run-summary-secondary">
            <div><span>Status</span><strong id="production-run-status"><%= production.status.replace(/_/g, ' ') %></strong></div>
            <div><span>Assets in this run</span><strong><%= production.jobs.length %></strong></div>
            <div><span>Started</span><strong><%= production.started_at %></strong></div>
        </section>

        <% if (typeof planProgress !== 'undefined' && planProgress) { %>
            <section class="production-review-status" aria-label="Overall production plan progress">
                <div><h2>Overall plan progress</h2><p id="plan-progress-overall"><strong><%= planProgress.completed.length %> of <%= planProgress.total %></strong> steps completed across Production work. The plan contains <%= planProgress.readyToUseAssetCount %> ready-to-use asset<%= planProgress.readyToUseAssetCount === 1 ? '' : 's' %> and <%= planProgress.planningFoundationCount %> free supporting document<%= planProgress.planningFoundationCount === 1 ? '' : 's' %>.</p></div>
                <div><h2>Current work</h2><p id="plan-progress-current"><%= planProgress.batchNew.length %> new item<%= planProgress.batchNew.length === 1 ? '' : 's' %> in this run; <%= planProgress.batchIncomplete.length %> remain incomplete. <%= planProgress.reused.length %> completed supporting item<%= planProgress.reused.length === 1 ? '' : 's' %> reused.</p></div>
                <div><h2>Saved for later</h2><p id="plan-progress-deferred"><%= planProgress.deferred.length %> deliverable<%= planProgress.deferred.length === 1 ? '' : 's' %> <%= planProgress.deferred.length === 1 ? 'remains' : 'remain' %> deferred (estimated <%= planProgress.remainingEstimatedCost %> generation<%= planProgress.remainingEstimatedCost === 1 ? '' : 's' %>).</p></div>
            </section>
        <% } %>

        <% function renderCards(items, actionLabel) { %><ol><% items.forEach(function(job, index) { %><li data-production-sequence="<%= job.sequence_order %>"><span class="production-job-order"><%= index + 1 %></span><div><h3><%= job.title %></h3><p><%= job.display_description || job.description %></p><% if (job.researchSummary) { %><small><%= job.researchSummary.status %><% if (job.researchSummary.sources) { %> · <%= job.researchSummary.sources %> source<%= job.researchSummary.sources === 1 ? '' : 's' %><% } %></small><% } %><% if (job.status === 'waiting_dependency') { %><small class="production-dependency-state">CopyQuick will continue when the supporting work is ready.</small><% } %><% if (job.error_message) { %><small class="production-job-error"><%= job.error_message %></small><% } %><% if (job.status === 'recovery_required') { %><small class="production-job-recovery">Recovery required: CopyQuick needs to verify the previous attempt before trying again.</small><% } %><span class="production-result-actions"><% if (job.status === 'completed' && job.generation_id) { %><a class="production-result-link" href="/generation/<%= job.generation_id %>"><%= actionLabel %> →</a><% } %></span></div><span class="production-job-status status-<%= job.status %>"><%= job.customer_status || (job.status || "completed").replaceAll("_", " ") %></span></li><% }); %></ol><% } %>

        <% if (delivery.readyForReview.length) { %><section class="production-output-section" aria-labelledby="ready-assets-title">
            <header class="production-output-section-header">
                <div><span class="build-plan-eyebrow">Your outputs</span><h2 id="ready-assets-title">Ready for review</h2></div><strong><%= delivery.readyForReview.length %></strong>
            </header>
            <p class="production-output-intro">Open finished assets to review, copy, or download them.</p><div class="production-studio-phase"><% renderCards(delivery.readyForReview, 'Open'); %></div>
        </section><% } %>
        <% if (delivery.needsAttention.length) { %><section class="production-output-section production-attention" aria-labelledby="needs-attention-title"><header class="production-output-section-header"><h2 id="needs-attention-title">Needs attention</h2><strong><%= delivery.needsAttention.length %></strong></header><div class="production-studio-phase"><% renderCards(delivery.needsAttention, 'Review issue'); %></div></section><% } %>
        <% if (delivery.researchSources.length) { %><section class="production-output-section" aria-labelledby="research-sources-title"><header class="production-output-section-header"><div><span class="build-plan-eyebrow">Trust & evidence</span><h2 id="research-sources-title">Research &amp; Sources</h2></div></header><p>Sources and evidence reviewed for claims that required external research.</p><div class="production-studio-phase"><% renderCards(delivery.researchSources, 'Review sources'); %></div></section><% } %>
        <% if (delivery.strategyPlanning.length) { %><details class="production-foundation-disclosure"><summary><span>Strategy &amp; Planning</span><small><%= delivery.strategyPlanning.length %> supporting document<%= delivery.strategyPlanning.length === 1 ? '' : 's' %></small></summary><div class="production-foundation-content"><p>Supporting decisions and planning CopyQuick used to create your finished work.</p><div class="production-studio-phase"><% renderCards(delivery.strategyPlanning, 'Review'); %></div></div></details><% } %>

        <% if (typeof synthesis !== 'undefined' && synthesis) { %>
            <section class="production-next-steps" aria-labelledby="production-next-steps-title">
                <span class="build-plan-eyebrow">Decision summary</span>
                <h2 id="production-next-steps-title">What to do next</h2>
                <p><strong>Current stage:</strong> <%= synthesis.currentStage %></p>
                <div class="production-next-steps-grid">
                    <div><h3>Concept directions</h3><ul><% synthesis.conceptDirections.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                    <div><h3>Largest open decisions</h3><ul><% synthesis.openDecisions.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                    <div><h3>Immediate validation actions</h3><ul><% synthesis.immediateActions.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                    <div><h3>Evidence needed</h3><ul><% synthesis.evidenceNeeded.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                </div>
                <h3><%= synthesis.unlockTitle || 'Before listing and launch assets unlock' %></h3>
                <ul><% synthesis.unlockConditions.forEach(function(item) { %><li><%= item %></li><% }); %></ul>
            </section>
        <% } %>

        <% if (hasExpiredLease) { %>
            <form action="/production/<%= production.id %>/run-next" method="POST" class="production-run-next">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-primary">Review Interrupted Work</button>
                <small>Checks persisted results before deciding whether retry is safe.</small>
            </form>
        <% } %>
        <noscript>
            <form action="/production/<%= production.id %>/run-next" method="POST" class="production-run-next">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline">Continue Production</button>
                <small>Optional no-JavaScript fallback. Production continues automatically.</small>
            </form>
        </noscript>
    </div>
</div>
<script src="/js/productionCompletionTransition.js"></script>
<script>
(function () {
    var runId = <%- JSON.stringify(production.id) %>;
    var completionTransition = window.CopyQuickProductionCompletionTransition;
    var latestRunStatus = <%- JSON.stringify(production.status) %>;
    var statusRequestTimeoutMs = 10000;
    var retryDelayMs = 5000;
    var maxRetryDelayMs = 60000;
    var pollTimer = null;
    var activeController = null;
    var pollingStopped = false;
    function stopPolling() {
        pollingStopped = true;
        if (pollTimer) window.clearTimeout(pollTimer);
        pollTimer = null;
    }
    var transitionToCompletedResults = completionTransition.createCompletionTransition({
        targetUrl: '/production/' + runId,
        stopPolling: stopPolling,
        navigate: function (url) { window.location.replace(url); }
    });
    function label(value) { return String(value || '').replace(/_/g, ' '); }
    function liveStatus(message) {
        var element = document.getElementById('production-live-status');
        if (element) element.textContent = message || '';
    }
    function countLabel(count, singular, plural) {
        return count + ' ' + (count === 1 ? singular : plural);
    }
    function updatePlanProgress(progress) {
        if (!progress) return;
        var overall = document.getElementById('plan-progress-overall');
        var current = document.getElementById('plan-progress-current');
        var deferred = document.getElementById('plan-progress-deferred');
        if (overall) overall.textContent = progress.completedCount + ' of ' + progress.totalCount
            + ' steps completed across Production work. The plan contains '
            + countLabel(progress.readyToUseAssetCount, 'ready-to-use asset', 'ready-to-use assets') + ' and '
            + countLabel(progress.planningFoundationCount, 'free supporting document', 'free supporting documents') + '.';
        if (current) current.textContent = countLabel(progress.batchNewCount, 'new item', 'new items')
            + ' in this run; ' + progress.batchIncompleteCount + ' remain incomplete. '
            + countLabel(progress.reusedCount, 'completed supporting item', 'completed supporting items') + ' reused.';
        if (deferred) deferred.textContent = countLabel(progress.deferredCount, 'item', 'items')
            + (progress.deferredCount === 1 ? ' remains' : ' remain') + ' deferred (estimated '
            + countLabel(progress.remainingEstimatedCost, 'work item', 'work items') + ').';
    }
    function scheduleRefresh(delay) {
        if (pollingStopped || completionTransition.isTerminalRunStatus(latestRunStatus)) return;
        if (pollTimer) window.clearTimeout(pollTimer);
        pollTimer = window.setTimeout(function () {
            pollTimer = null;
            refreshProduction();
        }, delay);
    }
    function retryProduction() {
        var delay = retryDelayMs;
        retryDelayMs = Math.min(maxRetryDelayMs, retryDelayMs * 2);
        scheduleRefresh(delay);
    }
    async function refreshProduction() {
        var controller = new AbortController();
        activeController = controller;
        var requestTimeout = window.setTimeout(function () { controller.abort(); }, statusRequestTimeoutMs);
        try {
            var response = await fetch('/production/' + runId + '/status', {
                headers: { Accept: 'application/json' },
                signal: controller.signal
            });
            if (!response.ok) throw new Error('Production status request failed');
            var state = await response.json();
            latestRunStatus = state.runStatus;
            retryDelayMs = 5000;
            liveStatus('');
            if (transitionToCompletedResults(state.runStatus)) return;
            document.getElementById('production-progress').textContent = state.completedCount + ' of ' + state.totalCount + ' completed.';
            document.getElementById('production-run-status').textContent = label(state.runStatus);
            updatePlanProgress(state.planProgress);
            state.jobs.forEach(function (job) {
                var row = document.querySelector('[data-production-sequence="' + job.sequenceOrder + '"]');
                if (!row) return;
                var status = row.querySelector('.production-job-status');
                status.className = 'production-job-status status-' + job.status;
                status.textContent = label(job.status);
                var dependencyState = row.querySelector('.production-dependency-state');
                if (job.status !== 'waiting_dependency' && dependencyState) dependencyState.remove();
                var actions = row.querySelector('.production-result-actions');
                var resultLink = actions && actions.querySelector('.production-result-link');
                if (job.resultUrl && actions) {
                    if (!resultLink) {
                        resultLink = document.createElement('a');
                        resultLink.className = 'production-result-link';
                        actions.appendChild(resultLink);
                    }
                    resultLink.href = job.resultUrl;
                    resultLink.textContent = 'View Deliverable →';
                } else if (resultLink) {
                    resultLink.remove();
                }
            });
            scheduleRefresh(3000);
        } catch (err) {
            liveStatus('Live updates are temporarily unavailable. Retrying automatically…');
            retryProduction();
        } finally {
            window.clearTimeout(requestTimeout);
            if (activeController === controller) activeController = null;
        }
    }
    window.addEventListener('pagehide', function () {
        stopPolling();
        if (activeController) activeController.abort();
    });
    window.addEventListener('pageshow', function (event) {
        if (!event.persisted) return;
        pollingStopped = false;
        scheduleRefresh(0);
    });
    scheduleRefresh(3000);
})();
</script>
