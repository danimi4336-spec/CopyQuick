<div class="production-studio-page">
    <div class="container production-studio-container">
        <header class="production-studio-header">
            <span class="build-plan-eyebrow">Production Studio</span>
            <h1><%= typeof planName !== 'undefined' ? planName : 'Production Plan' %></h1>
            <p><strong id="production-progress"><%= completedCount %> of <%= production.jobs.length %> completed.</strong> Jobs below show their real persisted queue state.</p>
        </header>

        <% if (executionNotice) { %><div class="alert production-execution-notice" role="status"><%= executionNotice %></div><% } %>
        <% if (production.objective === 'build_brand' && production.status === 'completed') { %><p><a class="btn btn-primary" href="/brand-brain?fromRun=<%= production.id %>">Review decisions for Brand Brain</a></p><% } %>
        <p id="production-live-status" class="production-live-status" role="status" aria-live="polite"></p>

        <section class="production-run-summary">
            <div><span>Run status</span><strong id="production-run-status"><%= production.status.replace(/_/g, ' ') %></strong></div>
            <div><span><%= production.costingModel === 'ready_to_use_asset_unit' ? 'Paid production credits' : 'Historical production units' %></span><strong><%= production.production_cost_units %></strong></div>
            <div><span>Started</span><strong><%= production.started_at %></strong></div>
        </section>

        <% if (typeof planProgress !== 'undefined' && planProgress) { %>
            <section class="production-review-status" aria-label="Overall production plan progress">
                <div><h2>Overall plan progress</h2><p id="plan-progress-overall"><strong><%= planProgress.completed.length %> of <%= planProgress.total %></strong> steps completed across production batches. The plan contains <%= planProgress.readyToUseAssetCount %> ready-to-use asset<%= planProgress.readyToUseAssetCount === 1 ? '' : 's' %> and <%= planProgress.planningFoundationCount %> free planning prerequisite<%= planProgress.planningFoundationCount === 1 ? '' : 's' %>.</p></div>
                <div><h2>Current batch</h2><p id="plan-progress-current"><%= planProgress.batchNew.length %> new deliverable<%= planProgress.batchNew.length === 1 ? '' : 's' %> in this run; <%= planProgress.batchIncomplete.length %> remain incomplete. <%= planProgress.reused.length %> prerequisite<%= planProgress.reused.length === 1 ? '' : 's' %> reused.</p></div>
                <div><h2>Saved for later</h2><p id="plan-progress-deferred"><%= planProgress.deferred.length %> deliverable<%= planProgress.deferred.length === 1 ? '' : 's' %> <%= planProgress.deferred.length === 1 ? 'remains' : 'remain' %> deferred (estimated <%= planProgress.remainingEstimatedCost %> generation<%= planProgress.remainingEstimatedCost === 1 ? '' : 's' %>).</p></div>
            </section>
        <% } %>

        <% const readyToUsePhases = phases.map(function(phase) { return { ...phase, jobs: phase.jobs.filter(function(job) { return job.artifactPolicy?.role !== 'planning_foundation'; }) }; }).filter(function(phase) { return phase.jobs.length; }); %>
        <% const planningFoundationJobs = phases.reduce(function(items, phase) { return items.concat(phase.jobs.filter(function(job) { return job.artifactPolicy?.role === 'planning_foundation'; })); }, []); %>

        <section class="production-output-section" aria-labelledby="ready-assets-title">
            <header class="production-output-section-header">
                <div><span class="build-plan-eyebrow">Your outputs</span><h2 id="ready-assets-title">Ready-to-use assets</h2></div>
                <strong><%= readyToUsePhases.reduce(function(total, phase) { return total + phase.jobs.length; }, 0) %> asset<%= readyToUsePhases.reduce(function(total, phase) { return total + phase.jobs.length; }, 0) === 1 ? '' : 's' %></strong>
            </header>
            <p class="production-output-intro">Open these deliverables to copy, export, or put them to work.</p>
            <div class="production-studio-phases production-ready-asset-phases">
            <% let readyAssetNumber = 0; %>
            <% readyToUsePhases.forEach(function(phase) { %>
                <section class="production-studio-phase">
                    <header>
                        <span>Ready-to-use</span>
                        <h2><%= phase.title %></h2>
                    </header>
                    <ol>
                        <% phase.jobs.forEach(function(job) { %>
                            <% readyAssetNumber += 1; %>
                            <li data-production-sequence="<%= job.sequence_order %>">
                                <span class="production-job-order"><%= readyAssetNumber %></span>
                                <div>
                                    <h3><%= job.title %></h3>
                                    <small>Ready-to-use asset · paid production output</small>
                                    <p><%= job.display_description %></p>
                                    <% if (job.status === 'waiting_dependency' && job.dependencies.length) { %><small class="production-dependency-state">Waiting for <%= job.dependencies.length %> prerequisite<%= job.dependencies.length === 1 ? '' : 's' %>.</small><% } %>
                                    <% if (job.error_message) { %><small class="production-job-error"><%= job.error_message %></small><% } %>
                                    <% if (job.status === 'recovery_required') { %><small class="production-job-recovery">CopyQuick will not regenerate this item until its prior attempt can be verified safely.</small><% } %>
                                    <span class="production-result-actions"><% if (job.status === 'completed' && job.generation_id) { %><a class="production-result-link" href="/generation/<%= job.generation_id %>">View Deliverable →</a><% } %></span>
                                </div>
                                <span class="production-job-status status-<%= job.status %>"><%= job.status.replace(/_/g, ' ') %></span>
                            </li>
                        <% }); %>
                    </ol>
                </section>
            <% }); %>
            </div>
        </section>

        <% if (planningFoundationJobs.length) { %>
            <details class="production-foundation-disclosure">
                <summary>
                    <span>Free planning foundation deliverables</span>
                    <small><%= planningFoundationJobs.length %> internal prerequisite<%= planningFoundationJobs.length === 1 ? '' : 's' %> · no production credits</small>
                </summary>
                <div class="production-foundation-content">
                    <p>CopyQuick used these internal insights to guide the ready-to-use assets above. Open them only when you want to review the strategy or assumptions behind the work.</p>
                    <ol>
                        <% planningFoundationJobs.forEach(function(job, foundationIndex) { %>
                            <li data-production-sequence="<%= job.sequence_order %>">
                                <span class="production-job-order"><%= foundationIndex + 1 %></span>
                                <div>
                                    <h3><%= job.title %></h3>
                                    <small>Free planning foundation · internal use</small>
                                    <% if (job.error_message) { %><small class="production-job-error"><%= job.error_message %></small><% } %>
                                    <% if (job.status === 'recovery_required') { %><small class="production-job-recovery">CopyQuick will not regenerate this item until its prior attempt can be verified safely.</small><% } %>
                                    <span class="production-result-actions"><% if (job.status === 'completed' && job.generation_id) { %><a class="production-result-link" href="/generation/<%= job.generation_id %>">Review foundation →</a><% } %></span>
                                </div>
                                <span class="production-job-status status-<%= job.status %>"><%= job.status.replace(/_/g, ' ') %></span>
                            </li>
                        <% }); %>
                    </ol>
                </div>
            </details>
        <% } %>

        <% if (typeof synthesis !== 'undefined' && synthesis) { %>
            <section class="production-next-steps" aria-labelledby="production-next-steps-title">
                <span class="build-plan-eyebrow">Decision summary</span>
                <h2 id="production-next-steps-title">What to do next</h2>
                <p><strong>Current stage:</strong> <%= synthesis.currentStage %></p>
                <div class="production-next-steps-grid">
                    <div><h3>Concept directions</h3><ul><% synthesis.conceptDirections.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                    <div><h3>Largest open decisions</h3><ul><% synthesis.openDecisions.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                    <div><h3>Immediate validation actions</h3><ul><% synthesis.immediateActions.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                    <div><h3>Evidence needed</h3><ul><% synthesis.evidenceNeeded.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div>
                </div>
                <h3><%= synthesis.unlockTitle || 'Before listing and launch assets unlock' %></h3>
                <ul><% synthesis.unlockConditions.forEach(function(item) { %><li><%= item %></li><% }); %></ul>
            </section>
        <% } %>

        <% if (hasExpiredLease) { %>
            <form action="/production/<%= production.id %>/run-next" method="POST" class="production-run-next">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-primary">Review Interrupted Work</button>
                <small>Checks persisted results before deciding whether retry is safe.</small>
            </form>
        <% } %>
        <noscript>
            <form action="/production/<%= production.id %>/run-next" method="POST" class="production-run-next">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline">Continue Production</button>
                <small>Optional no-JavaScript fallback. Production continues automatically.</small>
            </form>
        </noscript>
    </div>
</div>
<script>
(function () {
    var runId = <%- JSON.stringify(production.id) %>;
    var terminal = ['completed', 'partially_completed', 'failed', 'blocked', 'canceled'];
    var latestRunStatus = <%- JSON.stringify(production.status) %>;
    var statusRequestTimeoutMs = 10000;
    var retryDelayMs = 5000;
    var maxRetryDelayMs = 60000;
    var pollTimer = null;
    var activeController = null;
    var pollingStopped = false;
    function label(value) { return String(value || '').replace(/_/g, ' '); }
    function liveStatus(message) {
        var element = document.getElementById('production-live-status');
        if (element) element.textContent = message || '';
    }
    function countLabel(count, singular, plural) {
        return count + ' ' + (count === 1 ? singular : plural);
    }
    function updatePlanProgress(progress) {
        if (!progress) return;
        var overall = document.getElementById('plan-progress-overall');
        var current = document.getElementById('plan-progress-current');
        var deferred = document.getElementById('plan-progress-deferred');
        if (overall) overall.textContent = progress.completedCount + ' of ' + progress.totalCount
            + ' steps completed across production batches. The plan contains '
            + countLabel(progress.readyToUseAssetCount, 'ready-to-use asset', 'ready-to-use assets') + ' and '
            + countLabel(progress.planningFoundationCount, 'free planning prerequisite', 'free planning prerequisites') + '.';
        if (current) current.textContent = countLabel(progress.batchNewCount, 'new deliverable', 'new deliverables')
            + ' in this run; ' + progress.batchIncompleteCount + ' remain incomplete. '
            + countLabel(progress.reusedCount, 'prerequisite', 'prerequisites') + ' reused.';
        if (deferred) deferred.textContent = countLabel(progress.deferredCount, 'deliverable', 'deliverables')
            + (progress.deferredCount === 1 ? ' remains' : ' remain') + ' deferred (estimated '
            + countLabel(progress.remainingEstimatedCost, 'generation', 'generations') + ').';
    }
    function scheduleRefresh(delay) {
        if (pollingStopped || terminal.includes(latestRunStatus)) return;
        if (pollTimer) window.clearTimeout(pollTimer);
        pollTimer = window.setTimeout(function () {
            pollTimer = null;
            refreshProduction();
        }, delay);
    }
    function retryProduction() {
        var delay = retryDelayMs;
        retryDelayMs = Math.min(maxRetryDelayMs, retryDelayMs * 2);
        scheduleRefresh(delay);
    }
    async function refreshProduction() {
        var controller = new AbortController();
        activeController = controller;
        var requestTimeout = window.setTimeout(function () { controller.abort(); }, statusRequestTimeoutMs);
        try {
            var response = await fetch('/production/' + runId + '/status', {
                headers: { Accept: 'application/json' },
                signal: controller.signal
            });
            if (!response.ok) throw new Error('Production status request failed');
            var state = await response.json();
            latestRunStatus = state.runStatus;
            retryDelayMs = 5000;
            liveStatus('');
            document.getElementById('production-progress').textContent = state.completedCount + ' of ' + state.totalCount + ' completed.';
            document.getElementById('production-run-status').textContent = label(state.runStatus);
            updatePlanProgress(state.planProgress);
            state.jobs.forEach(function (job) {
                var row = document.querySelector('[data-production-sequence="' + job.sequenceOrder + '"]');
                if (!row) return;
                var status = row.querySelector('.production-job-status');
                status.className = 'production-job-status status-' + job.status;
                status.textContent = label(job.status);
                var dependencyState = row.querySelector('.production-dependency-state');
                if (job.status !== 'waiting_dependency' && dependencyState) dependencyState.remove();
                var actions = row.querySelector('.production-result-actions');
                var resultLink = actions && actions.querySelector('.production-result-link');
                if (job.resultUrl && actions) {
                    if (!resultLink) {
                        resultLink = document.createElement('a');
                        resultLink.className = 'production-result-link';
                        actions.appendChild(resultLink);
                    }
                    resultLink.href = job.resultUrl;
                    resultLink.textContent = 'View Deliverable →';
                } else if (resultLink) {
                    resultLink.remove();
                }
            });
            scheduleRefresh(3000);
        } catch (err) {
            liveStatus('Live updates are temporarily unavailable. Retrying automatically…');
            retryProduction();
        } finally {
            window.clearTimeout(requestTimeout);
            if (activeController === controller) activeController = null;
        }
    }
    window.addEventListener('pagehide', function () {
        pollingStopped = true;
        if (pollTimer) window.clearTimeout(pollTimer);
        pollTimer = null;
        if (activeController) activeController.abort();
    });
    window.addEventListener('pageshow', function (event) {
        if (!event.persisted) return;
        pollingStopped = false;
        scheduleRefresh(0);
    });
    scheduleRefresh(3000);
})();
</script>
