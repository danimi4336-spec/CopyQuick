<div class="reflection-page">
    <div class="container reflection-container">
        <header class="reflection-header">
            <span class="reflection-eyebrow">Business Reflection</span>
            <h1>Here's what I've learned about your business.</h1>
            <p>Review what I understand, refine anything that is still open, and continue when there is enough grounding for useful strategy.</p>
        </header>

        <% if (error) { %><div class="alert alert-error reflection-alert" role="alert"><%= error %></div><% } %>
        <% if (confirmed) { %><div class="alert reflection-success" role="status">Your business understanding is confirmed and ready for planning.</div><% } %>

        <div class="reflection-groups">
            <% reflection.groups.forEach(function(group) { %>
                <section class="reflection-group" aria-labelledby="reflection-domain-<%= group.domain.replace(/\s+/g, '-').toLowerCase() %>">
                    <div class="reflection-group-header">
                        <h2 id="reflection-domain-<%= group.domain.replace(/\s+/g, '-').toLowerCase() %>"><%= group.domain %></h2>
                        <span><%= group.statusLabel %></span>
                    </div>
                    <div class="reflection-fields">
                        <% group.fields.forEach(function(field) { %>
                            <% if (field.editable === false) { %>
                            <div class="reflection-field">
                                <span class="reflection-field-copy">
                                    <span class="reflection-field-label"><%= field.label %></span>
                                    <% if (field.values && field.values.length) { %>
                                        <ul><% field.values.forEach(function(value) { %><li><%= value %></li><% }); %></ul>
                                    <% } else { %>
                                        <strong><%= field.value %></strong>
                                    <% } %>
                                    <% if (field.additionalDetail) { %><span><strong>Additional idea:</strong> <%= field.additionalDetail %></span><% } %>
                                    <% if (field.semanticNote) { %><small><%= field.semanticNote %></small><% } %>
                                </span>
                            </div>
                            <% } else { %>
                            <details class="reflection-field">
                                <summary>
                                    <span class="reflection-field-copy">
                                        <span class="reflection-field-label"><%= field.label %></span>
                                        <strong><%= field.value %></strong>
                                        <small><%= field.confidenceMessage %></small>
                                    </span>
                                    <span class="reflection-edit-label">Edit</span>
                                </summary>
                                <form action="/discovery/reflection/edit" method="POST" class="reflection-edit-form">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="field" value="<%= field.key %>">
                                    <label for="reflection-<%= field.key %>">Update <%= field.label.toLowerCase() %></label>
                                    <div>
                                        <input id="reflection-<%= field.key %>" type="text" name="value" value="<%= field.value %>" maxlength="2000" required>
                                        <button type="submit" class="btn btn-outline">Save</button>
                                    </div>
                                </form>
                            </details>
                            <% } %>
                        <% }); %>
                    </div>
                </section>
            <% }); %>
        </div>

        <% if (reflection.optionalKnowledgeGaps.length) { %>
            <section class="reflection-improvements" aria-labelledby="reflection-improvements-title">
                <h2 id="reflection-improvements-title">Areas I'd still like to improve</h2>
                <p>These details can make future recommendations more precise, but they will not hold up your plan.</p>
                <ul>
                    <% reflection.optionalKnowledgeGaps.forEach(function(domain) { %><li><%= domain %></li><% }); %>
                </ul>
            </section>
        <% } %>

        <section class="reflection-readiness <%= planningReadiness.ready ? 'ready' : 'blocked' %>">
            <% if (planningReadiness.ready) { %>
                <div>
                    <h2>We know enough to build a useful strategy.</h2>
                    <p><%= objective === 'get_more_customers' ? 'The essential customer-acquisition decisions are established. Any future unknowns will remain clearly marked rather than guessed.' : 'The essential product decisions are established. Optional unknowns will remain clearly marked rather than guessed.' %></p>
                </div>
            <% } else { %>
                <div>
                    <h2>Your current foundation is clear, but an important decision is still open.</h2>
                    <p>CopyQuick will not invent this information or build generic strategy around it. Refine the relevant field above when you are ready.</p>
                    <% var blockingItems = (reflection.blockingRequirements || []).concat(reflection.unaskedEssentialRequirements || []); %>
                    <% if (blockingItems.length) { %>
                        <ul class="reflection-blocking-list">
                            <% blockingItems.forEach(function(item) { %><li><%= item.domain %></li><% }); %>
                        </ul>
                    <% } %>
                </div>
            <% } %>
            <div class="reflection-navigation-actions">
                <form action="/discovery/back" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-outline btn-lg">← Back</button></form>
                <form action="/discovery/reflection/plan" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-primary btn-lg" <%- planningReadiness.ready ? '' : 'disabled aria-disabled="true"' %>>Build My Personalized Plan</button></form>
            </div>
        </section>
    </div>
</div>
