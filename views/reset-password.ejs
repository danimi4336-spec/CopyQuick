<div class="auth-container"><div class="auth-card">
    <% if (success) { %>
        <h2>Password updated</h2><p>Your password has been changed and existing sessions have been signed out.</p>
        <a href="/login" class="btn btn-primary btn-block">Log In</a>
    <% } else { %>
        <h2>Choose a new password</h2>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <% if (token) { %><form action="/reset-password" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="token" value="<%= token %>">
            <div class="form-group"><label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="password" required minlength="8" maxlength="1024"></div>
            <button type="submit" class="btn btn-primary btn-block">Update Password</button>
        </form><% } %>
        <p class="auth-footer"><a href="/forgot-password">Request a new link</a></p>
    <% } %>
</div></div>
