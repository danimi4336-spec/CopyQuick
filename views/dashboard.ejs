<div class="container dashboard">
    <header class="dashboard-header fade-in">
        <div>
            <h1>Welcome back, <%= user.name || 'there' %>!</h1>
            <p class="text-secondary">Here's your CopyQuick activity overview.</p>
        </div>
        <div class="dashboard-plan">
            <span class="badge badge-<%= user.plan_tier %>"><%= user.plan_tier %></span>
            <span class="usage-text"><%= user.generations_used %> / <%= user.monthly_limit %> used</span>
        </div>
    </header>

    <div class="stats-grid fade-in">
        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">📝</div>
            <div class="stat-info">
                <span class="stat-value"><%= totalGenerations %></span>
                <span class="stat-label">Total Generations</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-pink">⭐</div>
            <div class="stat-info">
                <span class="stat-value"><%= favorites %></span>
                <span class="stat-label">Favorites</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-green">📅</div>
            <div class="stat-info">
                <span class="stat-value"><%= thisMonth %></span>
                <span class="stat-label">This Month</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-amber">🎯</div>
            <div class="stat-info">
                <span class="stat-value"><%= user.plan_tier.charAt(0).toUpperCase() + user.plan_tier.slice(1) %></span>
                <span class="stat-label">Subscription</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <section class="generator-tool fade-in">
            <div class="card p-4">
                <h2 class="h3 mb-4">Generate New Copy</h2>
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-error"><%- error %></div>
                <% } %>
                <form action="/dashboard/generate" method="POST">
                    <div class="form-group">
                        <label for="productDescription">What are you selling?</label>
                        <textarea id="productDescription" name="productDescription" rows="3" placeholder="Describe your product or service..." required><%= typeof input !== 'undefined' ? input.productDescription : '' %></textarea>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="targetAudience">Target Audience</label>
                            <input type="text" id="targetAudience" name="targetAudience" placeholder="e.g. Busy moms, Tech founders" value="<%= typeof input !== 'undefined' ? input.targetAudience : '' %>">
                        </div>
                        <div class="form-group">
                            <label for="contentType">Content Type</label>
                            <select id="contentType" name="contentType">
                                <option value="subject_line" <%= (typeof input !== 'undefined' && input.contentType === 'subject_line') ? 'selected' : '' %>>Email Subject Lines</option>
                                <option value="social_post" <%= (typeof input !== 'undefined' && input.contentType === 'social_post') ? 'selected' : '' %>>Social Media Posts</option>
                                <option value="ad_headline" <%= (typeof input !== 'undefined' && input.contentType === 'ad_headline') ? 'selected' : '' %>>Ad Headlines & Copy</option>
                                <option value="product_description" <%= (typeof input !== 'undefined' && input.contentType === 'product_description') ? 'selected' : '' %>>Product Descriptions</option>
                                <option value="cta" <%= (typeof input !== 'undefined' && input.contentType === 'cta') ? 'selected' : '' %>>Call-to-Actions</option>
                                <option value="email_campaign" <%= (typeof input !== 'undefined' && input.contentType === 'email_campaign') ? 'selected' : '' %>>Email Campaigns</option>
                                <option value="blog_intro" <%= (typeof input !== 'undefined' && input.contentType === 'blog_intro') ? 'selected' : '' %>>Blog Post Introductions</option>
                                <option value="sales_message" <%= (typeof input !== 'undefined' && input.contentType === 'sales_message') ? 'selected' : '' %>>Sales Messages</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="tone">Tone</label>
                            <select id="tone" name="tone">
                                <option value="professional" <%= (typeof input !== 'undefined' && input.tone === 'professional') ? 'selected' : '' %>>Professional</option>
                                <option value="casual" <%= (typeof input !== 'undefined' && input.tone === 'casual') ? 'selected' : '' %>>Casual</option>
                                <option value="urgent" <%= (typeof input !== 'undefined' && input.tone === 'urgent') ? 'selected' : '' %>>Urgent</option>
                                <option value="humorous" <%= (typeof input !== 'undefined' && input.tone === 'humorous') ? 'selected' : '' %>>Humorous</option>
                                <option value="inspirational" <%= (typeof input !== 'undefined' && input.tone === 'inspirational') ? 'selected' : '' %>>Inspirational</option>
                            </select>
                        </div>
                        <div class="form-group" style="display:flex;align-items:flex-end;">
                            <button type="submit" class="btn btn-primary btn-block">Generate Copy</button>
                        </div>
                    </div>
                </form>
            </div>

            <% if (results) { %>
                <div class="results-container mt-5">
                    <div class="results-header">
                        <h2 class="h3 mb-4">Results</h2>
                        <a href="/history" class="btn btn-outline btn-sm">View All History →</a>
                    </div>
                    <div class="results-grid">
                        <% results.forEach((result, index) => { %>
                            <div class="result-card">
                                <div class="result-header">
                                    <span class="result-tag"><%= result.tone %></span>
                                    <div class="result-actions">
                                        <button class="copy-btn" onclick="copyToClipboard('copy-text-<%= index %>', this)" title="Copy">📋</button>
                                    </div>
                                </div>
                                <p class="result-text" id="copy-text-<%= index %>"><%= result.text %></p>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </section>

        <aside class="dashboard-sidebar">
            <!-- Content Type Breakdown -->
            <% if (typeBreakdown && typeBreakdown.length > 0) { %>
                <div class="sidebar-card">
                    <h3 class="h4">Content Breakdown</h3>
                    <div class="breakdown-list">
                        <% typeBreakdown.forEach(function(item) { %>
                            <div class="breakdown-item">
                                <span class="breakdown-label"><%= item.content_type.replace(/_/g, ' ') %></span>
                                <span class="breakdown-count"><%= item.count %></span>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <!-- Recent Activity -->
            <% if (recent && recent.length > 0) { %>
                <div class="sidebar-card">
                    <h3 class="h4">Recent Activity</h3>
                    <div class="activity-list">
                        <% recent.slice(0, 5).forEach(function(item) { %>
                            <a href="/generation/<%= item.id %>" class="activity-item">
                                <span class="activity-title"><%= item.title || item.input_text.substring(0, 40) %></span>
                                <span class="activity-meta"><%= item.content_type.replace(/_/g, ' ') %> · <%= new Date(item.created_at).toLocaleDateString() %></span>
                            </a>
                        <% }); %>
                    </div>
                    <a href="/history" class="sidebar-link">View all →</a>
                </div>
            <% } else { %>
                <div class="sidebar-card">
                    <h3 class="h4">Getting Started</h3>
                    <p class="sidebar-text">Describe your product above and click "Generate Copy" to create your first marketing content.</p>
                </div>
            <% } %>
        </aside>
    </div>
</div>

<script>
function copyToClipboard(elementId, btn) {
    const text = document.getElementById(elementId).innerText;
    navigator.clipboard.writeText(text).then(() => {
        btn.textContent = '✅';
        setTimeout(() => { btn.textContent = '📋'; }, 1500);
    });
}

(function() {
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach(function(el) { observer.observe(el); });
})();
</script>

<style>
.results-header { display: flex; justify-content: space-between; align-items: center; }
.btn-sm { padding: 0.4rem 0.8rem; font-size: 0.85rem; }
</style>