<div class="container builder-center">
    <!-- ===== SECTION 1: Welcome + Brand Brain Progress ===== -->
    <section class="bc-welcome fade-in">
        <div class="bc-welcome-left">
            <h1 class="bc-greeting"><span id="greeting"></span>, <%= user.name || 'there' %> 👋</h1>
            <p class="bc-tagline">Ready to build something amazing today?</p>
            <div class="bc-action-row">
                <% if (brainPct === 0) { %>
                    <a href="/brand-brain" class="btn btn-primary btn-lg">🧠 Start Your Brand Brain →</a>
                <% } else if (campaignCount === 0) { %>
                    <a href="#mode-campaign-trigger" class="btn btn-primary btn-lg campaign-trigger">🚀 Launch Your First Campaign →</a>
                <% } else { %>
                    <a href="#mode-campaign-trigger" class="btn btn-primary btn-lg campaign-trigger">🚀 Continue Building →</a>
                <% } %>
            </div>
        </div>
        <div class="bc-welcome-right">
            <div class="bc-brain-mini">
                <div class="bc-brain-circle"><%= brainPct %>%</div>
                <div class="bc-brain-info">
                    <strong>Brand Brain</strong>
                    <span><%= brainFilled %> of 8 fields complete</span>
                </div>
                <a href="/brand-brain" class="bc-brain-arrow">→</a>
            </div>
            <div class="bc-usage-mini">
                <div class="bc-usage-bar"><div class="bc-usage-fill" style="width:<%= Math.min((user.generations_used / user.monthly_limit) * 100, 100) %>%"></div></div>
                <span class="bc-usage-text"><%= user.generations_used %> / <%= user.monthly_limit %> used</span>
            </div>
        </div>
    </section>

    <!-- ===== SECTION 2: Next Recommended Action ===== -->
    <section class="bc-recommendation fade-in">
        <div class="bc-rec-card">
            <div class="bc-rec-icon">
                <% if (brainPct === 0) { %>🧠<% } else if (brainPct < 100) { %>📋<% } else if (quickCount === 0) { %>⚡<% } else if (bundleCount === 0) { %>📦<% } else if (campaignCount === 0) { %>🚀<% } else { %>🎯<% } %>
            </div>
            <div class="bc-rec-body">
                <span class="bc-rec-label">Next Recommended Action</span>
                <span class="bc-rec-text">
                    <% if (brainPct === 0) { %>
                        Set up your Brand Brain — CopyQuick needs to learn about your business
                    <% } else if (brainPct < 100) { %>
                        Complete your Brand Brain profile for better AI suggestions
                    <% } else if (quickCount === 0) { %>
                        Start with a Quick Generate to see CopyQuick in action
                    <% } else if (bundleCount === 0) { %>
                        Try a Marketing Bundle — generate multiple assets at once
                    <% } else if (campaignCount === 0) { %>
                        Launch your first Complete Campaign
                    <% } else { %>
                        You're on a roll! Create another campaign or try something new
                    <% } %>
                </span>
            </div>
            <a href="<%= brainPct === 0 || brainPct < 100 ? '/brand-brain' : quickCount === 0 ? '#mode-quick-trigger' : bundleCount === 0 ? '#mode-bundle-trigger' : '#mode-campaign-trigger' %>" class="btn btn-primary bc-rec-btn">
                <% if (brainPct === 0) { %>Set Up Now<% } else if (brainPct < 100) { %>Continue<% } else if (quickCount === 0) { %>Try Now<% } else if (bundleCount === 0) { %>Try Bundle<% } else if (campaignCount === 0) { %>Build Campaign<% } else { %>Keep Going<% } %> →
            </a>
        </div>
    </section>

    <!-- ===== SECTION 3: Three Builder Mode Cards ===== -->
    <section class="bc-modes fade-in">
        <h2 class="bc-section-title">What would you like to build today?</h2>
        <div class="bc-modes-grid">
            <div class="bc-mode-card mode-trigger" data-mode="quick" id="mode-quick-trigger">
                <div class="bc-mode-bg">⚡</div>
                <h3 class="bc-mode-title">Quick Generate</h3>
                <p class="bc-mode-desc">Generate a single piece of copy in seconds. Subject lines, social posts, ads, and more.</p>
                <span class="bc-mode-action">Generate Now →</span>
            </div>
            <div class="bc-mode-card mode-trigger" data-mode="bundle" id="mode-bundle-trigger">
                <div class="bc-mode-bg">📦</div>
                <h3 class="bc-mode-title">Marketing Bundle</h3>
                <p class="bc-mode-desc">Generate multiple marketing assets at once — emails, ads, listings, and more.</p>
                <span class="bc-mode-action">Build Bundle →</span>
            </div>
            <div class="bc-mode-card mode-trigger" data-mode="campaign" id="mode-campaign-trigger">
                <div class="bc-mode-bg">🚀</div>
                <h3 class="bc-mode-title">Complete Campaign</h3>
                <p class="bc-mode-desc">Create an entire multi-channel campaign. Email, social, ads, landing pages, and more.</p>
                <span class="bc-mode-action">Build My Campaign →</span>
            </div>
        </div>
    </section>

    <!-- ===== BUILDER GOALS (interactive welcome cards) ===== -->
    <section class="bc-goals fade-in">
        <h2 class="bc-section-title" id="bc-goals-title"><%= builderGoal && goalLabels && goalLabels[builderGoal] ? '🎯 Your Goal: ' + goalLabels[builderGoal] : '👋 What would you like to build today?' %></h2>
        <% if (builderGoal && goalLabels && goalLabels[builderGoal]) { %><p class="bc-goals-sub">You can update your goal anytime — it helps CopyQuick personalize your recommendations.</p><% } %>
        <div class="builder-goals-grid" id="builderGoalsGrid">
            <% var goalsList = [
              { id:'launch_product', icon:'🚀', title:'Launch a New Product', desc:'Generate copy for your product launch across all channels' },
              { id:'grow_business', icon:'📈', title:'Grow My Existing Business', desc:'Create marketing content to attract more customers' },
              { id:'start_store', icon:'🛒', title:'Start an Online Store', desc:'Build product descriptions, ads, and email campaigns' },
              { id:'promote_service', icon:'💼', title:'Promote My Service', desc:'Create compelling copy for your service-based business' },
              { id:'build_brand', icon:'✨', title:'Build My Brand', desc:'Establish your brand voice across all marketing touchpoints' },
              { id:'campaigns', icon:'📢', title:'Generate Marketing Campaigns', desc:'Create complete multi-channel campaigns from one idea' }
            ]; %>
            <% goalsList.forEach(function(g){ %>
                <div class="builder-goal-card <%= builderGoal === g.id ? 'selected' : '' %>" data-goal="<%= g.id %>" data-icon="<%= g.icon %>">
                    <span class="goal-icon"><%= g.icon %></span>
                    <span class="goal-title"><%= g.title %></span>
                    <span class="goal-desc"><%= g.desc %></span>
                </div>
            <% }); %>
            <!-- Something Else (wide card) -->
            <div class="builder-goal-card builder-goal-card-wide <%= builderGoal === 'other' ? 'selected' : '' %>" data-goal="other" id="otherGoalCard">
                <span class="goal-icon">💡</span>
                <span class="goal-title">Something Else</span>
                <span class="goal-desc">Tell us what you want to build</span>
            </div>
        </div>

        <!-- Custom input for "Something Else" -->
        <div id="otherCustomWrap" class="other-custom-wrap <%= builderGoal === 'other' ? 'visible' : '' %>">
            <label for="otherGoalInput">Tell CopyQuick what you want to build</label>
            <textarea id="otherGoalInput" rows="2" placeholder="Example: I want to promote a church event, launch a local service, or create content for my nonprofit."></textarea>
        </div>

        <div class="bc-goals-action" id="bcGoalsAction">
            <a href="/brand-brain" class="btn btn-primary btn-lg" id="bcCtaBtn">🚀 Let's Get Started →</a>
        </div>
    </section>

    <!-- ===== SECTION 4: Builder Journey Progress ===== -->
    <section class="bc-journey fade-in">
        <h2 class="bc-section-title">Your Builder Journey</h2>
        <div class="bc-journey-track">
            <div class="bc-journey-step done"><span class="step-icon">✅</span><span class="step-label">Account Created</span></div>
            <div class="bc-journey-step done"><span class="step-icon">✅</span><span class="step-label">Logged In</span></div>
            <div class="bc-journey-step <%= journey.brandBrainStarted ? 'done' : 'current' %>">
                <span class="step-icon"><%= journey.brandBrainStarted ? '✅' : '🟡' %></span>
                <span class="step-label">Brand Brain Started</span>
            </div>
            <div class="bc-journey-step <%= journey.firstQuickGenerate ? 'done' : '' %>">
                <span class="step-icon"><%= journey.firstQuickGenerate ? '✅' : '⬜' %></span>
                <span class="step-label">First Quick Generate</span>
            </div>
            <div class="bc-journey-step <%= journey.firstMarketingBundle ? 'done' : '' %>">
                <span class="step-icon"><%= journey.firstMarketingBundle ? '✅' : '⬜' %></span>
                <span class="step-label">First Marketing Bundle</span>
            </div>
            <div class="bc-journey-step <%= journey.firstCompleteCampaign ? 'done' : '' %>">
                <span class="step-icon"><%= journey.firstCompleteCampaign ? '✅' : '⬜' %></span>
                <span class="step-label">First Complete Campaign</span>
            </div>
            <div class="bc-journey-step <%= journey.firstFavorite ? 'done' : '' %>">
                <span class="step-icon"><%= journey.firstFavorite ? '✅' : '⬜' %></span>
                <span class="step-label">First Favorite</span>
            </div>
            <div class="bc-journey-step <%= journey.firstDownload ? 'done' : '' %>">
                <span class="step-icon"><%= journey.firstDownload ? '✅' : '⬜' %></span>
                <span class="step-label">First Download</span>
            </div>
        </div>
    </section>

    <!-- ===== SECTION 5: Quick Actions ===== -->
    <section class="bc-quick-actions fade-in">
        <h2 class="bc-section-title">Quick Actions</h2>
        <div class="bc-qa-grid">
            <a href="#mode-campaign-trigger" class="bc-qa-card mode-trigger" data-mode="campaign">🚀 Build My Campaign</a>
            <a href="/brand-brain" class="bc-qa-card">🧠 Brand Brain™</a>
            <a href="#mode-bundle-trigger" class="bc-qa-card mode-trigger" data-mode="bundle">📦 Marketing Bundle</a>
            <a href="#mode-quick-trigger" class="bc-qa-card mode-trigger" data-mode="quick">⚡ Quick Generate</a>
            <a href="/dashboard" class="bc-qa-card">🖼️ Product Images</a>
            <a href="/dashboard" class="bc-qa-card">🎥 Video Scripts</a>
            <a href="/dashboard" class="bc-qa-card">📄 Landing Pages</a>
            <a href="/dashboard" class="bc-qa-card">📧 Email Campaigns</a>
        </div>
    </section>

    <!-- ===== SECTION 6: Generator Tools (hidden until a mode is selected) ===== -->
    <div id="bc-tools" class="bc-tools-hidden">
        <div class="bc-tools-header">
            <button class="bc-back-btn" id="bcBackBtn">← Back</button>
            <h2 id="bcToolTitle">⚡ Quick Generate</h2>
        </div>

        <!-- ===== Quick ===== -->
        <div class="mode-panel active" id="mode-quick">
            <div class="card p-4">
                <div class="mode-panel-header">
                    <h2>⚡ Quick Generate</h2>
                    <p class="mode-panel-desc">Generate a single piece of content in seconds.</p>
                </div>
                <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%- error %></div><% } %>
                <form class="gen-form" action="/dashboard/generate" method="POST" data-mode="quick">
                    <div class="form-group">
                        <label for="quickProduct">Product / Service</label>
                        <textarea id="quickProduct" name="productDescription" rows="2" placeholder="Describe your product..." required><%= typeof input !== 'undefined' ? input.productDescription : '' %></textarea>
                    </div>
                    <div class="form-grid form-grid-3">
                        <div class="form-group">
                            <label for="quickContentType">Type</label>
                            <select id="quickContentType" name="contentType">
                                <option value="subject_line">Email Subject Lines</option>
                                <option value="social_post">Social Media Posts</option>
                                <option value="ad_headline">Ad Headlines</option>
                                <option value="product_description">Product Descriptions</option>
                                <option value="cta">Call-to-Actions</option>
                                <option value="email_campaign">Email Campaigns</option>
                                <option value="blog_intro">Blog Introductions</option>
                                <option value="sales_message">Sales Messages</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="quickTone">Tone</label>
                            <select id="quickTone" name="tone">
                                <option value="professional">Professional</option>
                                <option value="casual">Casual</option>
                                <option value="urgent">Urgent</option>
                                <option value="humorous">Humorous</option>
                                <option value="inspirational">Inspirational</option>
                            </select>
                        </div>
                        <div class="form-group" style="display:flex;align-items:flex-end;">
                            <button type="submit" class="btn btn-primary btn-block gen-btn">Generate</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="loading-skeleton" style="display:none;">
                <div class="result-card skeleton"><div class="skeleton-line w-40"></div><div class="skeleton-line w-80"></div><div class="skeleton-line w-60"></div></div>
                <div class="result-card skeleton"><div class="skeleton-line w-40"></div><div class="skeleton-line w-80"></div><div class="skeleton-line w-60"></div></div>
            </div>
            <div class="results-area-quick">
            <% if (results && typeof genMode === 'undefined') { %>
                <div class="results-container mt-5">
                    <div class="results-header"><h2 class="h3">Results</h2><a href="/history" class="btn btn-outline btn-sm">View All →</a></div>
                    <div class="gen-success-msg">✓ Done</div>
                    <div class="results-grid">
                        <% results.forEach(function(r,i){ %>
                            <div class="result-card premium-card" style="animation:cardFadeIn 0.3s ease-out <%= i*0.1 %>s both;">
                                <div class="result-variation-label">Variation <%= i+1 %></div>
                                <div class="result-tone-badge"><%= r.tone %></div>
                                <div class="result-body"><%= r.text.replace(/\n/g,'<br>') %></div>
                                <div class="result-card-actions">
                                    <button class="result-action-btn" onclick="copyText('<%= r.text.replace(/'/g,"\\'").replace(/\n/g,'\\n') %>',this)">📋 <span>Copy</span></button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
            </div>
        </div>

        <!-- ===== Bundle ===== -->
        <div class="mode-panel" id="mode-bundle">
            <div class="card p-4">
                <div class="mode-panel-header">
                    <h2>📦 Marketing Bundle</h2>
                    <p class="mode-panel-desc">Generate multiple marketing assets at once.</p>
                </div>
                <form class="gen-form" action="/dashboard/generate" method="POST" data-mode="bundle">
                    <div class="form-group">
                        <label for="bundleProduct">Product / Service</label>
                        <textarea id="bundleProduct" name="productDescription" rows="2" placeholder="Describe your product..." required></textarea>
                    </div>
                    <div class="form-grid form-grid-2">
                        <div class="form-group custom-select-wrap">
                            <label for="bundleTargetAudience">Target Audience</label>
                            <select id="bundleTargetAudience" name="targetAudience" data-custom="bundle-audience-custom">
                                <% audiencePresets.forEach(function(a){ %>
                                    <option value="<%= a %>"><%= a %></option>
                                <% }); %>
                            </select>
                            <div id="bundle-audience-custom" class="custom-field-hidden">
                                <textarea name="targetAudienceCustom" rows="2" placeholder="Example: Busy working mothers aged 25–45 looking for natural wellness products."></textarea>
                            </div>
                        </div>
                        <div class="form-group custom-select-wrap">
                            <label for="bundleVoice">Brand Voice</label>
                            <select id="bundleVoice" name="tone" data-custom="bundle-voice-custom">
                                <% brandVoices.forEach(function(v){ %>
                                    <option value="<%= v %>"><%= v %></option>
                                <% }); %>
                            </select>
                            <div id="bundle-voice-custom" class="custom-field-hidden">
                                <textarea name="toneCustom" rows="2" placeholder="Example: Warm, trustworthy, premium, and faith-friendly."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Select Assets to Generate</label>
                        <div class="bundle-assets-grid">
                            <% bundleAssets.forEach(function(a, i){ %>
                                <label class="bundle-asset-chip <%= a.default ? 'selected' : '' %>">
                                    <input type="checkbox" name="assets" value="<%= a.id %>:<%= a.label %>" <%= a.default ? 'checked' : '' %>>
                                    <span class="chip-icon"><%= a.icon %></span>
                                    <span class="chip-label"><%= a.label %></span>
                                </label>
                            <% }); %>
                        </div>
                        <span class="bundle-count" id="bundleCount">5 of 10 selected</span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg gen-btn">📦 Generate Bundle</button>
                </form>
            </div>
            <div class="results-area-bundle"></div>
        </div>

        <!-- ===== Campaign ===== -->
        <div class="mode-panel" id="mode-campaign">
            <div class="campaign-workspace">
                <div class="campaign-form-col">
                    <div class="card p-4">
                        <div class="mode-panel-header">
                            <h2>🚀 Complete Campaign</h2>
                            <p class="mode-panel-desc">Generate an entire multi-channel campaign from one idea.</p>
                        </div>
                        <form class="gen-form" action="/dashboard/generate" method="POST" data-mode="campaign">
                            <div class="form-group">
                                <label for="campaignProduct">Product / Service</label>
                                <textarea id="campaignProduct" name="productDescription" rows="2" placeholder="Describe your product or service..." required></textarea>
                            </div>
                            <div class="form-grid form-grid-2">
                                <div class="form-group custom-select-wrap">
                                    <label for="campaignTargetAudience">Target Audience</label>
                                    <select id="campaignTargetAudience" name="targetAudience" data-custom="campaign-audience-custom">
                                        <% audiencePresets.forEach(function(a){ %>
                                            <option value="<%= a %>"><%= a %></option>
                                        <% }); %>
                                    </select>
                                    <div id="campaign-audience-custom" class="custom-field-hidden">
                                        <textarea name="targetAudienceCustom" rows="2" placeholder="Example: Busy working mothers aged 25–45 looking for natural wellness products."></textarea>
                                    </div>
                                </div>
                                <div class="form-group custom-select-wrap">
                                    <label for="campaignVoice">Brand Voice</label>
                                    <select id="campaignVoice" name="tone" data-custom="campaign-voice-custom">
                                        <% brandVoices.forEach(function(v){ %>
                                            <option value="<%= v %>"><%= v %></option>
                                        <% }); %>
                                    </select>
                                    <div id="campaign-voice-custom" class="custom-field-hidden">
                                        <textarea name="toneCustom" rows="2" placeholder="Example: Warm, trustworthy, premium, and faith-friendly."></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group custom-select-wrap">
                                <label for="campaignGoal">Campaign Goal</label>
                                <select id="campaignGoal" name="goal" data-custom="campaign-goal-custom">
                                    <% goals.forEach(function(g){ %>
                                        <option value="<%= g %>"><%= g %></option>
                                    <% }); %>
                                </select>
                                <div id="campaign-goal-custom" class="custom-field-hidden">
                                    <textarea name="goalCustom" rows="2" placeholder="Example: Promote our new turmeric supplement to existing customers before Black Friday."></textarea>
                                </div>
                            </div>
                            <div class="campaign-sections-select">
                                <label>Campaign Sections</label>
                                <div class="campaign-section-btns">
                                    <% campaignSections.forEach(function(s, i){ %>
                                        <button type="button" class="campaign-sec-btn <%= i === 0 ? 'active' : '' %>" data-section="<%= s.id %>">
                                            <%= s.icon %> <%= s.label %>
                                        </button>
                                    <% }); %>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block btn-lg gen-btn campaign-cta">🚀 Build My Campaign</button>
                        </form>
                    </div>
                </div>
                <div class="campaign-deliverables-col">
                    <div class="card p-4 deliverables-card">
                        <div class="deliverables-header">
                            <h3 id="deliverables-title">✉️ Email Marketing Includes</h3>
                        </div>
                        <div class="deliverables-list" id="deliverables-list">
                            <% campaignSections[0].deliverables.forEach(function(d){ %>
                                <div class="deliverable-item">• <%= d %></div>
                            <% }); %>
                        </div>
                        <div class="deliverables-footer">
                            <span class="deliverables-count" id="deliverables-count"><%= campaignSections[0].deliverables.length %> assets</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="results-area-campaign"></div>
        </div>
    </div><!-- /bc-tools -->
</div><!-- /builder-center -->

<style>
/* ===== Builder Command Center Theme ===== */
.builder-center{max-width:960px;margin:0 auto;padding:2rem 0;}
.bc-section-title{font-size:0.85rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--secondary);margin-bottom:1rem;}

/* ===== Welcome ===== */
.bc-welcome{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;}
.bc-greeting{font-size:2rem;margin:0 0 0.25rem;}
.bc-tagline{font-size:1rem;color:var(--secondary);margin-bottom:1.25rem;}
.bc-action-row{display:flex;gap:0.75rem;flex-wrap:wrap;}
.bc-welcome-right{display:flex;flex-direction:column;gap:0.75rem;align-items:flex-end;min-width:180px;}
.bc-brain-mini{display:flex;align-items:center;gap:0.65rem;background:var(--light);padding:0.65rem 0.9rem;border-radius:0.75rem;width:100%;}
.bc-brain-circle{width:2.5rem;height:2.5rem;border-radius:50%;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:800;flex-shrink:0;}
.bc-brain-info{display:flex;flex-direction:column;gap:0.05rem;}
.bc-brain-info strong{font-size:0.8rem;}
.bc-brain-info span{font-size:0.7rem;color:var(--secondary);}
.bc-brain-arrow{color:var(--primary);font-weight:700;font-size:1.1rem;text-decoration:none;margin-left:auto;}
.bc-usage-mini{width:100%;}
.bc-usage-bar{height:4px;background:var(--border);border-radius:2px;overflow:hidden;margin-bottom:0.2rem;}
.bc-usage-fill{height:100%;border-radius:2px;transition:width 0.5s;background:var(--success);}
.bc-usage-text{font-size:0.7rem;color:var(--secondary);display:block;text-align:right;}

/* ===== Builder Goals ===== */
.bc-goals{margin-bottom:2.5rem;}
.bc-goals-sub{font-size:0.8rem;color:var(--secondary);margin:-0.5rem 0 1rem;}
.builder-goals-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;max-width:750px;}
.builder-goal-card{display:flex;flex-direction:column;gap:0.2rem;padding:1.25rem 1rem;border:2px solid var(--border);border-radius:1rem;cursor:pointer;transition:all 0.2s;background:var(--white);}
.builder-goal-card:hover{border-color:var(--primary);box-shadow:0 2px 8px rgba(79,70,229,0.1);}
.builder-goal-card.selected{border-color:var(--primary);background:var(--primary-light);box-shadow:0 0 0 3px rgba(79,70,229,0.15);}
.goal-radio{position:absolute;opacity:0;pointer-events:none;}
.goal-icon{font-size:1.5rem;margin-bottom:0.15rem;}
.goal-title{font-size:0.85rem;font-weight:700;color:var(--dark);}
.goal-desc{font-size:0.72rem;color:var(--secondary);max-width:none;line-height:1.35;}
.builder-goal-card-wide{grid-column:1/-1;flex-direction:row;align-items:center;gap:0.6rem;padding:0.75rem 1rem;}
.builder-goal-card-wide .goal-icon{font-size:1.2rem;margin-bottom:0;}
.builder-goal-card-wide .goal-desc{flex:1;}
.bc-goals-action{margin-top:1rem;}
.other-custom-wrap{display:none;max-height:0;overflow:hidden;transition:all 0.3s ease;margin-top:0.75rem;max-width:400px;}
.other-custom-wrap.visible{display:block;max-height:150px;}
.other-custom-wrap label{font-size:0.85rem;font-weight:600;margin-bottom:0.35rem;display:block;}
.other-custom-wrap textarea{width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border);border-radius:0.75rem;font-size:0.85rem;font-family:inherit;transition:border-color 0.2s;resize:vertical;}
.other-custom-wrap textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(79,70,229,0.1);}

/* ===== Recommendation ===== */
.bc-recommendation{margin-bottom:2.5rem;}
.bc-rec-card{display:flex;align-items:center;gap:1rem;padding:0.9rem 1.25rem;background:var(--primary-light);border:1px solid rgba(79,70,229,0.15);border-radius:0.9rem;transition:all 0.2s;}
.bc-rec-icon{font-size:1.5rem;flex-shrink:0;}
.bc-rec-body{flex:1;min-width:0;}
.bc-rec-label{display:block;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--primary);margin-bottom:0.15rem;}
.bc-rec-text{font-size:0.85rem;color:var(--dark);}
.bc-rec-btn{flex-shrink:0;padding:0.4rem 0.9rem;font-size:0.8rem;border-radius:0.5rem;}

/* ===== Three Builder Mode Cards ===== */
.bc-modes{margin-bottom:2.5rem;}
.bc-modes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
.bc-mode-card{position:relative;overflow:hidden;padding:1.75rem 1.5rem;border:1px solid var(--border);border-radius:1.25rem;background:var(--white);cursor:pointer;transition:all 0.25s;display:flex;flex-direction:column;gap:0.4rem;}
.bc-mode-card:hover{transform:translateY(-4px);box-shadow:0 8px 25px rgba(0,0,0,0.08);border-color:var(--primary);}
.bc-mode-bg{font-size:3rem;position:absolute;top:0.5rem;right:0.75rem;opacity:0.08;pointer-events:none;}
.bc-mode-title{font-size:1.15rem;font-weight:700;color:var(--dark);margin:0;position:relative;z-index:1;}
.bc-mode-desc{font-size:0.8rem;color:var(--secondary);line-height:1.45;max-width:none;position:relative;z-index:1;}
.bc-mode-action{font-size:0.8rem;font-weight:600;color:var(--primary);margin-top:auto;position:relative;z-index:1;}

/* ===== Builder Journey ===== */
.bc-journey{margin-bottom:2.5rem;}
.bc-journey-track{display:flex;gap:0.5rem;flex-wrap:wrap;}
.bc-journey-step{display:flex;align-items:center;gap:0.35rem;padding:0.45rem 0.8rem;border:1px solid var(--border);border-radius:1.5rem;font-size:0.78rem;background:var(--white);}
.bc-journey-step.done{border-color:var(--success);background:#d1fae5;}
.bc-journey-step.current{border-color:var(--primary);background:var(--primary-light);}
.step-icon{font-size:0.85rem;}
.step-label{font-weight:500;color:var(--dark);white-space:nowrap;}

/* ===== Quick Actions ===== */
.bc-quick-actions{margin-bottom:2.5rem;}
.bc-qa-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0.65rem;}
.bc-qa-card{display:flex;align-items:center;gap:0.5rem;padding:0.7rem 0.9rem;border:1px solid var(--border);border-radius:0.75rem;background:var(--white);text-decoration:none;font-size:0.82rem;font-weight:600;color:var(--dark);transition:all 0.15s;}
.bc-qa-card:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:var(--primary);}

/* ===== Tools Section (hidden by default) ===== */
.bc-tools-hidden{display:none;}
.bc-tools-visible{display:block;animation:fadeIn 0.3s ease-out;}
.bc-tools-header{display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;}
.bc-back-btn{background:none;border:none;font-size:0.9rem;font-weight:600;color:var(--primary);cursor:pointer;padding:0.25rem 0.5rem;font-family:inherit;}
.bc-back-btn:hover{opacity:0.8;}
.bc-tools-header h2{font-size:1.3rem;margin:0;}

/* ===== Shared Mode Styles ===== */
.mode-panel{display:none;}
.mode-panel.active{display:block;animation:fadeIn 0.25s ease-out;}
.mode-panel-header h2{font-size:1.25rem;margin-bottom:0.2rem;}
.mode-panel-desc{font-size:0.85rem;color:var(--secondary);margin-bottom:1.25rem;}

.bundle-assets-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;margin-bottom:0.5rem;}
.bundle-asset-chip{display:flex;align-items:center;gap:0.4rem;padding:0.45rem 0.6rem;border:1px solid var(--border);border-radius:0.6rem;cursor:pointer;transition:all 0.15s;font-size:0.8rem;background:var(--white);user-select:none;}
.bundle-asset-chip.selected{border-color:var(--primary);background:var(--primary-light);}
.bundle-asset-chip input{position:absolute;opacity:0;pointer-events:none;}
.bundle-asset-chip .chip-icon{font-size:1rem;}
.bundle-asset-chip .chip-label{font-size:0.8rem;font-weight:500;color:var(--dark);}
.bundle-count{font-size:0.75rem;color:var(--secondary);display:block;text-align:right;}

.campaign-workspace{display:grid;grid-template-columns:1fr 280px;gap:1.25rem;align-items:start;}
.campaign-sec-btn{display:inline-flex;align-items:center;gap:0.35rem;padding:0.45rem 0.7rem;border:1px solid var(--border);border-radius:0.5rem;background:var(--white);font-size:0.78rem;font-weight:500;color:var(--secondary);cursor:pointer;transition:all 0.15s;font-family:inherit;}
.campaign-sec-btn:hover{border-color:var(--primary);color:var(--dark);}
.campaign-sec-btn.active{border-color:var(--primary);background:var(--primary-light);color:var(--primary);font-weight:600;}
.campaign-section-btns{display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.35rem;margin-bottom:1.25rem;}
.campaign-cta{margin-top:1rem;font-size:1rem;padding:0.8rem;}

.deliverables-card{position:sticky;top:5rem;}
.deliverables-header h3{font-size:1rem;margin-bottom:0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border);}
.deliverables-list{display:flex;flex-direction:column;gap:0.2rem;}
.deliverable-item{font-size:0.82rem;color:var(--secondary);padding:0.25rem 0;}
.deliverable-item:hover{color:var(--dark);}
.deliverables-footer{border-top:1px solid var(--border);margin-top:0.75rem;padding-top:0.6rem;}
.deliverables-count{font-size:0.75rem;font-weight:600;color:var(--primary);}

.custom-select-wrap{display:flex;flex-direction:column;gap:0.5rem;}
.custom-field-hidden{display:none;max-height:0;overflow:hidden;transition:all 0.3s ease;}
.custom-field-visible{display:block;max-height:120px;}
.custom-field-hidden textarea{width:100%;padding:0.55rem 0.7rem;border:1px solid var(--border);border-radius:0.6rem;font-size:0.82rem;font-family:inherit;transition:border-color 0.2s;resize:vertical;background:var(--white);}
.custom-field-hidden textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(79,70,229,0.1);}

.results-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem;}
.gen-success-msg{background:#d1fae5;color:#065f46;padding:0.5rem 1rem;border-radius:0.5rem;margin-bottom:1rem;font-weight:600;font-size:0.85rem;animation:slideDown 0.3s;}
@keyframes slideDown{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
@keyframes cardFadeIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.premium-card{border:1px solid var(--border);border-radius:1rem;padding:1.25rem;margin-bottom:0.75rem;background:var(--white);transition:all 0.2s;}
.premium-card:hover{box-shadow:var(--shadow-lg);border-color:var(--primary);}
.result-variation-label{font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--secondary);margin-bottom:0.35rem;}
.result-tone-badge{display:inline-block;background:var(--primary-light);color:var(--primary);font-size:0.65rem;font-weight:700;text-transform:uppercase;padding:0.15rem 0.5rem;border-radius:4px;margin-bottom:0.5rem;}
.result-body{font-size:0.9rem;color:var(--dark);line-height:1.6;margin-bottom:0.75rem;}
.result-card-actions{display:flex;gap:0.5rem;border-top:1px solid var(--border);padding-top:0.5rem;}
.result-action-btn{display:flex;align-items:center;gap:0.3rem;background:none;border:1px solid var(--border);border-radius:0.5rem;padding:0.3rem 0.7rem;font-size:0.8rem;cursor:pointer;transition:all 0.2s;color:var(--secondary);font-weight:500;font-family:inherit;}
.result-action-btn:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-light);}
.result-action-btn.copied{background:var(--success);color:white;border-color:var(--success);}
.loading-skeleton{display:none;}
.skeleton .skeleton-line{height:0.8rem;background:var(--border);border-radius:4px;margin-bottom:0.5rem;}

@media(max-width:992px){
    .campaign-workspace{grid-template-columns:1fr;}
    .deliverables-card{position:static;}
    .bc-qa-grid{grid-template-columns:repeat(2,1fr);}
}
@media(max-width:768px){
    .bc-welcome{flex-direction:column;align-items:flex-start;gap:1rem;}
    .bc-welcome-right{width:100%;}
    .bc-modes-grid{grid-template-columns:1fr;}
    .builder-goals-grid{grid-template-columns:1fr;max-width:400px;}
    .form-grid-3,.form-grid-2{grid-template-columns:1fr;}
    .bundle-assets-grid{grid-template-columns:repeat(2,1fr);}
    .bc-journey-track{gap:0.35rem;}
    .bc-qa-grid{grid-template-columns:repeat(2,1fr);}
}
</style>

<script>
(function(){
  var h=new Date().getHours(),g='Welcome back';
  if(h<12)g='Good morning';else if(h<17)g='Good afternoon';else if(h<22)g='Good evening';
  document.getElementById('greeting').textContent=g;

  // ===== Mode Card Triggers =====
  var tools=document.getElementById('bc-tools');
  var toolTitle=document.getElementById('bcToolTitle');
  var modePanels={
    quick:document.getElementById('mode-quick'),
    bundle:document.getElementById('mode-bundle'),
    campaign:document.getElementById('mode-campaign')
  };
  var modeNames={quick:'⚡ Quick Generate',bundle:'📦 Marketing Bundle',campaign:'🚀 Complete Campaign'};
  var activeMode='quick';

  function showMode(mode){
    activeMode=mode;
    Object.keys(modePanels).forEach(function(k){
      if(modePanels[k])modePanels[k].classList.toggle('active',k===mode);
    });
    toolTitle.textContent=modeNames[mode]||'';
    tools.classList.add('bc-tools-visible');
    tools.classList.remove('bc-tools-hidden');
    window.scrollTo({top:tools.offsetTop-20,behavior:'smooth'});
  }

  document.querySelectorAll('.mode-trigger').forEach(function(el){
    el.addEventListener('click',function(e){
      e.preventDefault();
      showMode(el.getAttribute('data-mode'));
    });
  });

  // Back button
  var backBtn=document.getElementById('bcBackBtn');
  if(backBtn){
    backBtn.addEventListener('click',function(){
      tools.classList.remove('bc-tools-visible');
      tools.classList.add('bc-tools-hidden');
      window.scrollTo({top:0,behavior:'smooth'});
    });
  }

  // ===== Custom Dropdowns =====
  document.querySelectorAll('[data-custom]').forEach(function(select){
    var wrap=document.getElementById(select.getAttribute('data-custom'));
    if(!wrap)return;
    function toggle(){
      if(select.value.toLowerCase()==='custom')wrap.classList.add('custom-field-visible');
      else wrap.classList.remove('custom-field-visible');
    }
    select.addEventListener('change',toggle);
    toggle();
  });

  // ===== Campaign Section Buttons =====
  var sections = <%= JSON.stringify(campaignSections) %>;
  var secBtns=document.querySelectorAll('.campaign-sec-btn');
  var titleEl=document.getElementById('deliverables-title');
  var listEl=document.getElementById('deliverables-list');
  var countEl=document.getElementById('deliverables-count');
  secBtns.forEach(function(btn){
    btn.addEventListener('click',function(){
      secBtns.forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      var id=btn.getAttribute('data-section');
      var sec=sections.find(function(s){return s.id===id;});
      if(sec){
        if(titleEl)titleEl.textContent=sec.icon+' '+sec.label+' Includes';
        if(listEl)listEl.innerHTML=sec.deliverables.map(function(d){return '<div class="deliverable-item">• '+d+'</div>';}).join('');
        if(countEl)countEl.textContent=sec.deliverables.length+' assets';
      }
    });
  });

  // ===== Bundle Asset Selection =====
  var chips=document.querySelectorAll('.bundle-asset-chip');
  var countEls=document.getElementById('bundleCount');
  function updateBundleCount(){
    var c=document.querySelectorAll('.bundle-asset-chip.selected').length;
    if(countEls)countEls.textContent=c+' of '+chips.length+' selected';
  }
  chips.forEach(function(chip){
    chip.addEventListener('click',function(e){
      var inp=chip.querySelector('input[type="checkbox"]');
      if(e.target===inp)return;
      inp.checked=!inp.checked;
      chip.classList.toggle('selected',inp.checked);
      updateBundleCount();
    });
    var inp=chip.querySelector('input');
    inp.addEventListener('change',function(){chip.classList.toggle('selected',inp.checked);updateBundleCount();});
  });
  updateBundleCount();

  // ===== Form Submission (AJAX) =====
  document.querySelectorAll('.gen-form').forEach(function(form){
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var mode=form.getAttribute('data-mode');
      var btn=form.querySelector('.gen-btn');
      var skel=mode==='quick'?form.closest('.mode-panel').querySelector('.loading-skeleton'):null;
      var resArea=mode==='quick'?form.closest('.mode-panel').querySelector('.results-area-quick'):
                   mode==='bundle'?form.closest('.mode-panel').querySelector('.results-area-bundle'):
                   form.closest('.mode-panel').querySelector('.results-area-campaign');
      btn.disabled=true;btn.textContent='⏳';
      if(skel)skel.style.display='block';
      if(resArea)resArea.innerHTML='';

      var d=new URLSearchParams();
      if(mode==='quick'){
        d.append('productDescription',document.getElementById('quickProduct').value);
        d.append('contentType',document.getElementById('quickContentType').value);
        d.append('tone',document.getElementById('quickTone').value);
        d.append('generationType','quick');
      } else if(mode==='bundle'){
        d.append('productDescription',document.getElementById('bundleProduct').value);
        var aud=document.getElementById('bundleTargetAudience');
        d.append('targetAudience',aud.value==='Custom'?document.querySelector('#bundle-audience-custom textarea').value:aud.value);
        var tone=document.getElementById('bundleVoice');
        d.append('tone',tone.value==='Custom'?document.querySelector('#bundle-voice-custom textarea').value:tone.value);
        var checked=[];
        document.querySelectorAll('#mode-bundle input[name="assets"]:checked').forEach(function(cb){checked.push(cb.value);});
        d.append('assets',checked.join(','));
        d.append('generationType','bundle');
      } else if(mode==='campaign'){
        d.append('productDescription',document.getElementById('campaignProduct').value);
        var aud=document.getElementById('campaignTargetAudience');
        d.append('targetAudience',aud.value==='Custom'?document.querySelector('#campaign-audience-custom textarea').value:aud.value);
        var tone=document.getElementById('campaignVoice');
        d.append('tone',tone.value==='Custom'?document.querySelector('#campaign-voice-custom textarea').value:tone.value);
        var goal=document.getElementById('campaignGoal');
        d.append('goal',goal.value==='Custom'?document.querySelector('#campaign-goal-custom textarea').value:goal.value);
        var activeSec=document.querySelector('.campaign-sec-btn.active');
        d.append('campaignSections',activeSec?activeSec.getAttribute('data-section'):'email');
        d.append('generationType','campaign');
      }

      fetch('/dashboard/generate',{
        method:'POST',
        headers:{'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json'},
        body:d.toString()
      })
      .then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Failed');return d;});})
      .then(function(d){
        btn.disabled=false;btn.textContent=mode==='quick'?'Generate':mode==='bundle'?'📦 Generate Bundle':'🚀 Build My Campaign';
        if(skel)skel.style.display='none';
        var h='<div class="results-container mt-5"><div class="results-header"><h2 class="h3">Results</h2><a href="/history" class="btn btn-outline btn-sm">View All →</a></div><div class="gen-success-msg">✓ Done</div><div class="results-grid">';
        d.results.forEach(function(r,i){
          h+='<div class="premium-card" style="animation:cardFadeIn 0.3s ease-out '+(i*0.1)+'s both;"><div class="result-variation-label">Variation '+(i+1)+'</div><div class="result-tone-badge">'+r.tone+'</div><div class="result-body">'+r.text.replace(/\n/g,'<br>')+'</div><div class="result-card-actions"><button class="result-action-btn" onclick="copyText(\''+r.text.replace(/'/g,"\\'").replace(/\n/g,'\\n')+'\',this)">📋 <span>Copy</span></button></div></div>';
        });
        h+='</div></div>';
        if(resArea)resArea.innerHTML=h;
      }).catch(function(e){
        btn.disabled=false;btn.textContent=mode==='quick'?'Generate':mode==='bundle'?'📦 Generate Bundle':'🚀 Build My Campaign';
        if(skel)skel.style.display='none';
        if(resArea)resArea.innerHTML='<div class="alert alert-error">'+e.message+'</div>';
      });
    });
  });

  // Copy function
  window.copyText=function(t,b){
    navigator.clipboard.writeText(t).then(function(){
      b.classList.add('copied');b.innerHTML='✅ <span>Copied!</span>';
      setTimeout(function(){b.classList.remove('copied');b.innerHTML='📋 <span>Copy</span>';},2000);
    });
  };

  // ===== Builder Goal Card Interactions =====
  var goalCards = document.querySelectorAll('.builder-goal-card');
  var ctaBtn = document.getElementById('bcCtaBtn');
  var goalsTitle = document.getElementById('bc-goals-title');
  var otherWrap = document.getElementById('otherCustomWrap');
  var otherInput = document.getElementById('otherGoalInput');
  var selectedGoal = null;
  var goalLabelsMap = {
    launch_product: { label:'Launch a New Product', cta:'🚀 Start Product Launch', icon:'🚀' },
    grow_business: { label:'Grow My Existing Business', cta:'📈 Grow My Business', icon:'📈' },
    start_store: { label:'Start an Online Store', cta:'🛒 Build My Store Campaign', icon:'🛒' },
    promote_service: { label:'Promote My Service', cta:'💼 Promote My Service', icon:'💼' },
    build_brand: { label:'Build My Brand', cta:'✨ Build My Brand', icon:'✨' },
    campaigns: { label:'Generate Marketing Campaigns', cta:'🚀 Build My Campaign', icon:'📢' },
    other: { label:'Something Else', cta:'🚀 Get Started', icon:'💡' }
  };
  var brainPct = <%= typeof brainPct !== 'undefined' ? brainPct : 0 %>;

  function updateCta(goalId, customText){
    var info = goalLabelsMap[goalId] || goalLabelsMap.other;
    var ctaText = info.cta;
    var route = brainPct >= 100 ? '/campaign-studio' : '/brand-brain';
    if(goalId === 'other' && customText && customText.trim()){
      ctaText = '🚀 ' + customText.trim().substring(0, 40) + (customText.trim().length > 40 ? '...' : '');
    }
    ctaBtn.textContent = ctaText;
    ctaBtn.href = route;
    if(goalId){
      goalsTitle.textContent = '🎯 Your Goal: ' + (goalId === 'other' && customText ? customText : info.label);
    } else {
      goalsTitle.textContent = '👋 What would you like to build today?';
    }
  }

  goalCards.forEach(function(card){
    card.addEventListener('click', function(e){
      // Stop any event propagation that could cause navigation
      e.stopPropagation();
      var goalId = card.getAttribute('data-goal');
      selectedGoal = goalId;
      // Deselect all
      goalCards.forEach(function(c){ c.classList.remove('selected'); });
      card.classList.add('selected');
      // Show/hide "Something Else" custom input
      if(goalId === 'other'){
        otherWrap.classList.add('visible');
        otherInput.focus();
        updateCta('other', otherInput.value.trim());
      } else {
        otherWrap.classList.remove('visible');
        updateCta(goalId, '');
      }
    });
  });

  // "Something Else" text input changes — visual only, no fetch
  if(otherInput){
    otherInput.addEventListener('input', function(){
      updateCta('other', otherInput.value.trim());
    });
  }

  // CTA button click — save goal then navigate
  ctaBtn.addEventListener('click', function(e){
    if(selectedGoal){
      var d = new URLSearchParams();
      d.append('goal', selectedGoal);
      if(selectedGoal === 'other' && otherInput){
        var customVal = otherInput.value.trim();
        if(customVal) d.append('goalCustom', customVal);
      }
      // Fire-and-forget save in background, then navigate
      fetch('/dashboard/update-goal', {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json'},
        body: d.toString()
      }).catch(function(err){ console.warn('Goal save:', err); });
    }
    // Allow default navigation to /brand-brain or /campaign-studio
  });

  // Initialize CTA + selection state on page load
  (function initGoals(){
    var selected = document.querySelector('.builder-goal-card.selected');
    if(selected){
      var g = selected.getAttribute('data-goal');
      selectedGoal = g;
      if(g === 'other'){
        updateCta('other', otherInput ? otherInput.value.trim() : '');
      } else {
        updateCta(g, '');
      }
    }
  })();

  // Fade-in
  var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:0.1});
  document.querySelectorAll('.fade-in').forEach(function(e){o.observe(e);});
})();
</script>