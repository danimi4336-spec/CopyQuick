<%
    var requestKeys = typeof generationRequestKeys !== 'undefined' ? generationRequestKeys : { quick: '', bundle: '' };
    var credits = typeof aiCredits !== 'undefined' && aiCredits ? aiCredits : {
        label: 'AI Credits',
        planName: user.plan_tier || 'Free',
        monthlyAllocation: user.monthly_limit || 10,
        used: 0,
        remaining: user.monthly_limit || 10,
        usedPercentage: 0,
        remainingPercentage: 100,
        periodEnd: null,
        manageUrl: user.plan_tier === 'free' ? '/pricing' : '/manage',
        manageLabel: user.plan_tier === 'free' ? 'Upgrade Plan' : 'Manage Plan'
    };
    var creditsRenewal = credits.periodEnd ? new Date(credits.periodEnd).toLocaleDateString() : 'Current monthly period';
%>
<div class="container builder-center">
    <% if (typeof billingReturnNotice !== 'undefined' && billingReturnNotice) { %>
        <div class="alert <%= billingReturnNotice.status === 'active' ? 'alert-success' : 'alert-info' %>" role="status">
            <%= billingReturnNotice.message %>
        </div>
    <% } %>
    <!-- ===== SECTION 1: Welcome + Brand Brain Progress ===== -->
    <section class="bc-welcome fade-in">
        <div class="bc-welcome-left">
            <h1 class="bc-greeting"><span id="greeting"></span>, <%= user.name || 'there' %> 👋</h1>
            <p class="bc-tagline">Ready to build something amazing today?</p>
            <div class="bc-action-row">
                <a href="/welcome" class="btn btn-primary btn-lg">🚀 Start a Guided Objective →</a>
                <a href="/brand-brain" class="btn btn-outline btn-lg">🧠 <%= brainPct === 0 ? 'Add Brand Context' : 'Update Brand Context' %></a>
            </div>
        </div>
        <div class="bc-welcome-right">
            <div class="bc-brain-mini">
                <div class="bc-brain-circle"><%= brainPct %>%</div>
                <div class="bc-brain-info">
                    <strong>Brand Brain</strong>
                    <span><%= brainFilled %> of 8 fields complete</span>
                </div>
                <a href="/brand-brain" class="bc-brain-arrow">→</a>
            </div>
            <button class="bc-ai-credits" type="button" id="aiCreditsOpen" aria-haspopup="dialog" aria-controls="aiCreditsDialog">
                <div class="bc-ai-top">
                    <strong><%= credits.label %></strong>
                    <span><%= credits.usedPercentage %>% Used</span>
                </div>
                <div class="bc-usage-bar" aria-hidden="true"><div class="bc-usage-fill" style="width:<%= credits.usedPercentage %>%"></div></div>
                <span class="bc-usage-text"><%= credits.remaining %> of <%= credits.monthlyAllocation %> remaining</span>
            </button>
        </div>
    </section>

    <div class="ai-credits-modal" id="aiCreditsDialog" role="dialog" aria-modal="true" aria-labelledby="aiCreditsTitle" aria-hidden="true">
        <div class="ai-credits-backdrop" data-ai-credits-close></div>
        <div class="ai-credits-card">
            <button class="ai-credits-close" type="button" aria-label="Close AI Credits" data-ai-credits-close>×</button>
            <div class="ai-credits-heading">
                <span class="ai-credits-kicker">Billing Period</span>
                <h2 id="aiCreditsTitle">AI Credits</h2>
                <p><%= credits.planName %> plan</p>
            </div>
            <div class="ai-credits-meter">
                <div class="bc-usage-bar"><div class="bc-usage-fill" style="width:<%= credits.usedPercentage %>%"></div></div>
                <span><%= credits.remainingPercentage %>% remaining</span>
            </div>
            <div class="ai-credits-grid">
                <div>
                    <span>Monthly Allocation</span>
                    <strong><%= credits.monthlyAllocation %></strong>
                </div>
                <div>
                    <span>Used This Period</span>
                    <strong><%= credits.used %></strong>
                </div>
                <div>
                    <span>Remaining</span>
                    <strong><%= credits.remaining %></strong>
                </div>
                <div>
                    <span>Renews</span>
                    <strong><%= creditsRenewal %></strong>
                </div>
            </div>
            <div class="copycredit-bank-note">
                <strong>CopyCredit Bank</strong>
                <p>Banked credits are coming later. For now, this shows the credits available in your current billing period.</p>
            </div>
            <% if (credits.manageUrl === '/manage') { %>
                <form action="/manage" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-primary btn-block"><%= credits.manageLabel %></button>
                </form>
            <% } else { %>
                <a href="<%= credits.manageUrl %>" class="btn btn-primary btn-block"><%= credits.manageLabel %></a>
            <% } %>
        </div>
    </div>

    <!-- ===== SECTION 2: Next Recommended Action ===== -->
    <section class="bc-recommendation fade-in">
        <div class="bc-rec-card">
            <div class="bc-rec-icon">
                <% if (quickCount === 0) { %>⚡<% } else if (bundleCount === 0) { %>📦<% } else { %>🚀<% } %>
            </div>
            <div class="bc-rec-body">
                <span class="bc-rec-label">Next Recommended Action</span>
                <span class="bc-rec-text">
                    <% if (quickCount === 0) { %>
                        Start with a Quick Generate to see CopyQuick in action
                    <% } else if (bundleCount === 0) { %>
                        Try a Marketing Bundle — generate multiple assets at once
                    <% } else { %>
                        Start a guided objective to turn your business context into a validated production plan
                    <% } %>
                </span>
            </div>
            <a href="<%= quickCount === 0 ? '#mode-quick' : bundleCount === 0 ? '#mode-bundle' : '/welcome' %>" class="btn btn-primary bc-rec-btn <%= quickCount === 0 || bundleCount === 0 ? 'mode-trigger' : '' %>" <%= quickCount === 0 || bundleCount === 0 ? 'data-mode-trigger="' + (quickCount === 0 ? 'quick' : 'bundle') + '"' : '' %>>
                <% if (quickCount === 0) { %>Try Now<% } else if (bundleCount === 0) { %>Try Bundle<% } else { %>Choose Objective<% } %> →
            </a>
        </div>
    </section>

    <!-- ===== GENERATION MODES ===== -->
    <section class="mode-launcher-section fade-in" aria-labelledby="modeLauncherTitle">
        <div class="mode-launcher-header">
            <span class="bc-rec-label">Generation Modes</span>
            <h2 id="modeLauncherTitle">Choose how you want to create</h2>
        </div>
        <div class="mode-launcher-grid">
            <a href="#mode-quick" class="mode-launch-card mode-trigger" id="mode-quick-trigger" data-mode-trigger="quick">
                <span class="mode-launch-icon">⚡</span>
                <strong>Quick Generate</strong>
                <span>Generate one individual marketing asset quickly.</span>
            </a>
            <a href="#mode-bundle" class="mode-launch-card mode-trigger" id="mode-bundle-trigger" data-mode-trigger="bundle">
                <span class="mode-launch-icon">📦</span>
                <strong>Marketing Bundle</strong>
                <span>Generate a coordinated bundle of related assets.</span>
            </a>
            <a href="/welcome" class="mode-launch-card" id="guided-objective-trigger">
                <span class="mode-launch-icon">🚀</span>
                <strong>Guided Objective</strong>
                <span>Build a validated strategy, plan, and production-ready set of deliverables.</span>
            </a>
        </div>
    </section>

    <!-- ===== Generator Tools (hidden, accessible via sidebar) ===== -->
    <div id="bc-tools" class="bc-tools-hidden" style="display:none;">
        <div class="bc-tools-header">
            <button class="bc-back-btn" id="bcBackBtn">← Back</button>
            <h2 id="bcToolTitle">⚡ Quick Generate</h2>
        </div>

        <!-- ===== Quick ===== -->
        <div class="mode-panel active" id="mode-quick">
            <div class="card p-4">
                <div class="mode-panel-header">
                    <h2>⚡ Quick Generate</h2>
                    <p class="mode-panel-desc">Create a single focused content draft.</p>
                </div>
                <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %><% if (typeof errorAction !== 'undefined' && errorAction) { %> <a href="<%= errorAction.href %>"><%= errorAction.label %></a><% } %></div><% } %>
                <form class="gen-form" action="/dashboard/generate" method="POST" data-mode="quick">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="idempotencyKey" value="<%= requestKeys.quick %>">
                    <div class="form-group">
                        <label for="quickProduct">Product / Service</label>
                        <textarea id="quickProduct" name="productDescription" rows="2" placeholder="Describe your product..." required><%= typeof input !== 'undefined' ? input.productDescription : '' %></textarea>
                    </div>
                    <div class="form-grid form-grid-3">
                        <div class="form-group">
                            <label for="quickContentType">Type</label>
                            <select id="quickContentType" name="contentType">
                                <option value="subject_line">Email Subject Lines</option>
                                <option value="social_post">Social Media Posts</option>
                                <option value="ad_headline">Ad Headlines</option>
                                <option value="product_description">Product Descriptions</option>
                                <option value="cta">Call-to-Actions</option>
                                <option value="email_campaign">Email Campaigns</option>
                                <option value="blog_intro">Blog Introductions</option>
                                <option value="sales_message">Sales Messages</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="quickTone">Tone</label>
                            <select id="quickTone" name="tone">
                                <option value="professional">Professional</option>
                                <option value="casual">Casual</option>
                                <option value="urgent">Urgent</option>
                                <option value="humorous">Humorous</option>
                                <option value="inspirational">Inspirational</option>
                            </select>
                        </div>
                        <div class="form-group" style="display:flex;align-items:flex-end;">
                            <button type="submit" class="btn btn-primary btn-block gen-btn">Generate</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="loading-skeleton" style="display:none;">
                <div class="result-card skeleton"><div class="skeleton-line w-40"></div><div class="skeleton-line w-80"></div><div class="skeleton-line w-60"></div></div>
                <div class="result-card skeleton"><div class="skeleton-line w-40"></div><div class="skeleton-line w-80"></div><div class="skeleton-line w-60"></div></div>
            </div>
            <div class="results-area-quick">
            <% if (results && typeof genMode === 'undefined') { %>
                <div class="results-container mt-5">
                    <div class="results-header"><h2 class="h3">Results</h2><a href="/history" class="btn btn-outline btn-sm">View All →</a></div>
                    <div class="gen-success-msg">✓ Done</div>
                    <div class="results-grid">
                        <% results.forEach(function(r,i){ %>
                            <div class="result-card premium-card" style="animation:cardFadeIn 0.3s ease-out <%= i*0.1 %>s both;">
                                <div class="result-variation-label">Variation <%= i+1 %></div>
                                <div class="result-tone-badge"><%= r.tone %></div>
                                <div class="result-body"><%= r.text %></div>
                                <div class="result-card-actions">
                                    <button class="result-action-btn server-copy-btn" data-copy-text="<%= r.text %>" type="button">📋 <span>Copy</span></button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
            </div>
        </div>

        <!-- ===== Bundle ===== -->
        <div class="mode-panel" id="mode-bundle">
            <div class="card p-4">
                <div class="mode-panel-header">
                    <h2>📦 Marketing Bundle</h2>
                    <p class="mode-panel-desc">Generate multiple marketing assets at once.</p>
                </div>
                <form class="gen-form" action="/dashboard/generate" method="POST" data-mode="bundle">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="idempotencyKey" value="<%= requestKeys.bundle %>">
                    <div class="form-group">
                        <label for="bundleProduct">Product / Service</label>
                        <textarea id="bundleProduct" name="productDescription" rows="2" placeholder="Describe your product..." required></textarea>
                    </div>
                    <div class="form-grid form-grid-2">
                        <div class="form-group custom-select-wrap">
                            <label for="bundleTargetAudience">Target Audience</label>
                            <select id="bundleTargetAudience" name="targetAudience" data-custom="bundle-audience-custom">
                                <% audiencePresets.forEach(function(a){ %>
                                    <option value="<%= a %>"><%= a %></option>
                                <% }); %>
                            </select>
                            <div id="bundle-audience-custom" class="custom-field-hidden">
                                <textarea name="targetAudienceCustom" rows="2" placeholder="Example: Busy working mothers aged 25–45 looking for natural wellness products."></textarea>
                            </div>
                        </div>
                        <div class="form-group custom-select-wrap">
                            <label for="bundleVoice">Brand Voice</label>
                            <select id="bundleVoice" name="tone">
                                <% brandVoices.forEach(function(v){ %>
                                    <option value="<%= v %>"><%= v %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Select Assets to Generate</label>
                        <div class="bundle-assets-grid" role="listbox" aria-label="Marketing Bundle assets" aria-multiselectable="true">
                            <% bundleAssets.forEach(function(a, i){ %>
                                <label class="bundle-asset-chip <%= a.default ? 'selected' : '' %>" data-asset-label="<%= a.label %>">
                                    <input type="checkbox" name="assets" value="<%= a.id %>:<%= a.label %>" tabindex="-1" aria-hidden="true" <%= a.default ? 'checked' : '' %>>
                                    <span class="bundle-order-badge" aria-hidden="<%= a.default ? 'false' : 'true' %>"></span>
                                    <span class="chip-icon"><%= a.icon %></span>
                                    <span class="chip-label"><%= a.label %></span>
                                </label>
                            <% }); %>
                        </div>
                        <span class="bundle-count" id="bundleCount">Selected Assets (5 / 5)</span>
                        <div class="bundle-selection-toast" id="bundleSelectionToast" role="status" aria-live="polite"></div>
                        <div class="sr-only" id="bundleSelectionLive" aria-live="polite"></div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg gen-btn">📦 Generate Bundle</button>
                </form>
            </div>
            <div class="results-area-bundle"></div>
        </div>

    </div><!-- /bc-tools -->
</div><!-- /builder-center -->

<style>
/* ===== Builder Command Center Theme ===== */
.builder-center{max-width:960px;margin:0 auto;padding:2rem 0;}
.bc-section-title{font-size:0.85rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:var(--secondary);margin-bottom:1rem;}

/* ===== Welcome ===== */
.bc-welcome{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;}
.bc-greeting{font-size:2rem;margin:0 0 0.25rem;}
.bc-tagline{font-size:1rem;color:var(--secondary);margin-bottom:1.25rem;}
.bc-action-row{display:flex;gap:0.75rem;flex-wrap:wrap;}
.bc-welcome-right{display:flex;flex-direction:column;gap:0.75rem;align-items:flex-end;min-width:180px;}
.bc-brain-mini{display:flex;align-items:center;gap:0.65rem;background:var(--light);padding:0.65rem 0.9rem;border-radius:0.75rem;width:100%;}
.bc-brain-circle{width:2.5rem;height:2.5rem;border-radius:50%;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:800;flex-shrink:0;}
.bc-brain-info{display:flex;flex-direction:column;gap:0.05rem;}
.bc-brain-info strong{font-size:0.8rem;}
.bc-brain-info span{font-size:0.7rem;color:var(--secondary);}
.bc-brain-arrow{color:var(--primary);font-weight:700;font-size:1.1rem;text-decoration:none;margin-left:auto;}
.bc-ai-credits{width:100%;border:1px solid var(--border);background:var(--white);border-radius:0.5rem;padding:0.65rem 0.8rem;cursor:pointer;font-family:inherit;text-align:left;transition:all 0.2s;}
.bc-ai-credits:hover{border-color:var(--primary);box-shadow:0 3px 10px rgba(15,23,42,0.08);}
.bc-ai-top{display:flex;justify-content:space-between;align-items:center;gap:0.75rem;margin-bottom:0.35rem;}
.bc-ai-top strong{font-size:0.8rem;color:var(--dark);}
.bc-ai-top span{font-size:0.72rem;font-weight:700;color:var(--primary);white-space:nowrap;}
.bc-usage-bar{height:4px;background:var(--border);border-radius:2px;overflow:hidden;margin-bottom:0.2rem;}
.bc-usage-fill{height:100%;border-radius:2px;transition:width 0.5s;background:var(--success);}
.bc-usage-text{font-size:0.7rem;color:var(--secondary);display:block;text-align:right;}
.ai-credits-modal{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:1rem;}
.ai-credits-modal.open{display:flex;}
.ai-credits-backdrop{position:absolute;inset:0;background:rgba(15,23,42,0.48);}
.ai-credits-card{position:relative;width:min(100%,440px);background:var(--white);border:1px solid var(--border);border-radius:0.5rem;box-shadow:var(--shadow-lg);padding:1.25rem;z-index:1;}
.ai-credits-close{position:absolute;top:0.7rem;right:0.7rem;width:2rem;height:2rem;border:1px solid var(--border);border-radius:0.5rem;background:var(--white);font-size:1.2rem;line-height:1;cursor:pointer;color:var(--secondary);}
.ai-credits-close:hover{color:var(--dark);border-color:var(--primary);}
.ai-credits-heading{padding-right:2rem;margin-bottom:1rem;}
.ai-credits-kicker{display:block;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--primary);margin-bottom:0.2rem;}
.ai-credits-heading h2{font-size:1.35rem;margin:0 0 0.15rem;color:var(--dark);}
.ai-credits-heading p{font-size:0.85rem;color:var(--secondary);margin:0;}
.ai-credits-meter{margin-bottom:1rem;}
.ai-credits-meter span{display:block;text-align:right;font-size:0.75rem;font-weight:700;color:var(--primary);}
.ai-credits-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0.75rem;margin-bottom:1rem;}
.ai-credits-grid div{border:1px solid var(--border);border-radius:0.5rem;padding:0.7rem;background:var(--light);}
.ai-credits-grid span{display:block;font-size:0.68rem;color:var(--secondary);font-weight:700;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.2rem;}
.ai-credits-grid strong{font-size:1rem;color:var(--dark);}
.copycredit-bank-note{border:1px dashed var(--border);border-radius:0.6rem;padding:0.8rem;margin-bottom:1rem;background:var(--light);}
.copycredit-bank-note strong{font-size:0.85rem;color:var(--dark);}
.copycredit-bank-note p{font-size:0.78rem;color:var(--secondary);line-height:1.45;margin:0.25rem 0 0;max-width:none;}

/* ===== Recommendation ===== */
.bc-recommendation{margin-bottom:2.5rem;}
.bc-rec-card{display:flex;align-items:center;gap:1rem;padding:0.9rem 1.25rem;background:var(--primary-light);border:1px solid rgba(79,70,229,0.15);border-radius:0.9rem;transition:all 0.2s;}
.bc-rec-icon{font-size:1.5rem;flex-shrink:0;}
.bc-rec-body{flex:1;min-width:0;}
.bc-rec-label{display:block;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--primary);margin-bottom:0.15rem;}
.bc-rec-text{font-size:0.85rem;color:var(--dark);}
.bc-rec-btn{flex-shrink:0;padding:0.4rem 0.9rem;font-size:0.8rem;border-radius:0.5rem;}

/* ===== Generation Mode Launcher ===== */
.mode-launcher-section{margin-bottom:1.75rem;}
.mode-launcher-header{margin-bottom:0.85rem;}
.mode-launcher-header h2{font-size:1.25rem;margin:0.15rem 0 0;}
.mode-launcher-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0.85rem;}
.mode-launch-card{display:flex;flex-direction:column;gap:0.35rem;padding:1rem;border:1px solid var(--border);border-radius:0.5rem;background:white;color:var(--dark);text-decoration:none;box-shadow:var(--shadow-sm);transition:transform 0.15s ease,box-shadow 0.15s ease,border-color 0.15s ease;}
.mode-launch-card:hover,.mode-launch-card:focus{transform:translateY(-1px);box-shadow:var(--shadow-md);border-color:var(--primary);outline:none;}
.mode-launch-icon{font-size:1.35rem;line-height:1;}
.mode-launch-card strong{font-size:0.95rem;}
.mode-launch-card span:last-child{font-size:0.78rem;color:var(--secondary);line-height:1.35;}

/* ===== Tools Section (hidden by default) ===== */
.bc-tools-hidden{display:none;}
.bc-tools-visible{display:block;animation:fadeIn 0.3s ease-out;}
.bc-tools-header{display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;}
.bc-back-btn{background:none;border:none;font-size:0.9rem;font-weight:600;color:var(--primary);cursor:pointer;padding:0.25rem 0.5rem;font-family:inherit;}
.bc-back-btn:hover{opacity:0.8;}
.bc-tools-header h2{font-size:1.3rem;margin:0;}

/* ===== Shared Mode Styles ===== */
.mode-panel{display:none;}
.mode-panel.active{display:block;animation:fadeIn 0.25s ease-out;}
.mode-panel-header h2{font-size:1.25rem;margin-bottom:0.2rem;}
.mode-panel-desc{font-size:0.85rem;color:var(--secondary);margin-bottom:1.25rem;}

.bundle-assets-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;margin-bottom:0.5rem;}
.bundle-asset-chip{position:relative;display:flex;align-items:center;gap:0.4rem;min-height:2.75rem;padding:0.5rem 0.6rem 0.5rem 2rem;border:1px solid var(--border);border-radius:0.6rem;cursor:pointer;transition:background-color 0.18s ease,border-color 0.18s ease,box-shadow 0.18s ease,transform 0.18s ease;font-size:0.8rem;background:var(--white);user-select:none;}
.bundle-asset-chip:hover,.bundle-asset-chip:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(79,70,229,0.1);outline:none;}
.bundle-asset-chip.selected{border-color:var(--primary);background:var(--primary-light);}
.bundle-asset-chip input{position:absolute;opacity:0;pointer-events:none;}
.bundle-order-badge{position:absolute;left:0.5rem;top:50%;transform:translateY(-50%) scale(0.85);display:flex;align-items:center;justify-content:center;width:1rem;height:1rem;border-radius:999px;background:var(--primary);color:white;font-size:0.65rem;font-weight:700;opacity:0;transition:opacity 0.18s ease,transform 0.18s ease;}
.bundle-asset-chip.selected .bundle-order-badge{opacity:1;transform:translateY(-50%) scale(1);}
.bundle-asset-chip .chip-icon{font-size:1rem;}
.bundle-asset-chip .chip-label{font-size:0.8rem;font-weight:500;color:var(--dark);}
.bundle-count{font-size:0.75rem;color:var(--secondary);display:block;text-align:right;}
.bundle-selection-toast{min-height:1.25rem;margin-top:0.5rem;padding:0.45rem 0.65rem;border-radius:0.5rem;background:var(--dark);color:white;font-size:0.78rem;line-height:1.35;opacity:0;transform:translateY(4px);transition:opacity 0.18s ease,transform 0.18s ease;pointer-events:none;}
.bundle-selection-toast.visible{opacity:1;transform:translateY(0);}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}

.custom-select-wrap{display:flex;flex-direction:column;gap:0.5rem;}
.custom-field-hidden{display:none;max-height:0;overflow:hidden;transition:all 0.3s ease;}
.custom-field-visible{display:block;max-height:120px;}
.custom-field-hidden textarea{width:100%;padding:0.55rem 0.7rem;border:1px solid var(--border);border-radius:0.6rem;font-size:0.82rem;font-family:inherit;transition:border-color 0.2s;resize:vertical;background:var(--white);}
.custom-field-hidden textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(79,70,229,0.1);}

.results-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:1rem;}
.gen-success-msg{background:#d1fae5;color:#065f46;padding:0.5rem 1rem;border-radius:0.5rem;margin-bottom:1rem;font-weight:600;font-size:0.85rem;animation:slideDown 0.3s;}
@keyframes slideDown{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
@keyframes cardFadeIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
.premium-card{border:1px solid var(--border);border-radius:1rem;padding:1.25rem;margin-bottom:0.75rem;background:var(--white);transition:all 0.2s;}
.premium-card:hover{box-shadow:var(--shadow-lg);border-color:var(--primary);}
.result-variation-label{font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--secondary);margin-bottom:0.35rem;}
.result-tone-badge{display:inline-block;background:var(--primary-light);color:var(--primary);font-size:0.65rem;font-weight:700;text-transform:uppercase;padding:0.15rem 0.5rem;border-radius:4px;margin-bottom:0.5rem;}
.result-body{font-size:0.9rem;color:var(--dark);line-height:1.6;margin-bottom:0.75rem;white-space:pre-wrap;}
.result-card-actions{display:flex;gap:0.5rem;border-top:1px solid var(--border);padding-top:0.5rem;}
.result-action-btn{display:flex;align-items:center;gap:0.3rem;background:none;border:1px solid var(--border);border-radius:0.5rem;padding:0.3rem 0.7rem;font-size:0.8rem;cursor:pointer;transition:all 0.2s;color:var(--secondary);font-weight:500;font-family:inherit;}
.result-action-btn:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-light);}
.result-action-btn.copied{background:var(--success);color:white;border-color:var(--success);}
.loading-skeleton{display:none;}
.skeleton .skeleton-line{height:0.8rem;background:var(--border);border-radius:4px;margin-bottom:0.5rem;}

@media(max-width:768px){
    .bc-welcome{flex-direction:column;align-items:flex-start;gap:1rem;}
    .bc-welcome-right{width:100%;}
    .mode-launcher-grid{grid-template-columns:1fr;}
    .form-grid-3,.form-grid-2{grid-template-columns:1fr;}
    .bundle-assets-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
    .bundle-selection-toast{font-size:0.75rem;}
    .ai-credits-grid{grid-template-columns:1fr;}
    .ai-credits-card{padding:1rem;}
}
</style>

<script src="/js/dashboardResults.js"></script>
<script src="/js/bundleAssetSelection.js"></script>
<script>
(function(){
  var h=new Date().getHours(),g='Welcome back';
  if(h<12)g='Good morning';else if(h<17)g='Good afternoon';else if(h<22)g='Good evening';
  document.getElementById('greeting').textContent=g;

  var aiCreditsDialog=document.getElementById('aiCreditsDialog');
  var aiCreditsOpen=document.getElementById('aiCreditsOpen');
  var aiCreditsLastFocus=null;
  function getAiCreditsFocusable(){
    if(!aiCreditsDialog)return[];
    return Array.prototype.slice.call(aiCreditsDialog.querySelectorAll('a[href],button:not([disabled]),textarea,input,select,[tabindex]:not([tabindex="-1"])'));
  }
  function setAiCreditsOpen(open){
    if(!aiCreditsDialog)return;
    aiCreditsDialog.classList.toggle('open',open);
    aiCreditsDialog.setAttribute('aria-hidden',open?'false':'true');
    document.body.style.overflow=open?'hidden':'';
    if(open){
      aiCreditsLastFocus=document.activeElement;
      var focusable=getAiCreditsFocusable();
      if(focusable.length)focusable[0].focus();
    }else if(aiCreditsLastFocus&&typeof aiCreditsLastFocus.focus==='function'){
      aiCreditsLastFocus.focus();
      aiCreditsLastFocus=null;
    }
  }
  if(aiCreditsOpen)aiCreditsOpen.addEventListener('click',function(){setAiCreditsOpen(true);});
  document.querySelectorAll('[data-ai-credits-close]').forEach(function(el){
    el.addEventListener('click',function(){setAiCreditsOpen(false);});
  });
  document.addEventListener('keydown',function(e){
    if(!aiCreditsDialog||!aiCreditsDialog.classList.contains('open'))return;
    if(e.key==='Escape')setAiCreditsOpen(false);
    if(e.key==='Tab'){
      var focusable=getAiCreditsFocusable();
      if(!focusable.length){e.preventDefault();return;}
      var first=focusable[0];
      var last=focusable[focusable.length-1];
      if(e.shiftKey&&document.activeElement===first){
        e.preventDefault();
        last.focus();
      }else if(!e.shiftKey&&document.activeElement===last){
        e.preventDefault();
        first.focus();
      }
    }
  });

  // ===== Custom Dropdowns =====
  document.querySelectorAll('[data-custom]').forEach(function(select){
    var wrap=document.getElementById(select.getAttribute('data-custom'));
    if(!wrap)return;
    function toggle(){
      if(select.value.toLowerCase()==='custom')wrap.classList.add('custom-field-visible');
      else wrap.classList.remove('custom-field-visible');
    }
    select.addEventListener('change',toggle);
    toggle();
  });

  // ===== Bundle Asset Selection =====
  var bundleSelection = window.CopyQuickBundleSelection && window.CopyQuickBundleSelection.init({
    maxSelected: 5
  });

	  // ===== Generation Mode Launcher =====
	  var toolsSection=document.getElementById('bc-tools');
	  var modePanels=document.querySelectorAll('.mode-panel');
	  var toolTitle=document.getElementById('bcToolTitle');
	  var backBtn=document.getElementById('bcBackBtn');
	  var modeTitles={
	    quick:'⚡ Quick Generate',
	    bundle:'📦 Marketing Bundle'
	  };
	  function showMode(mode){
	    if(!toolsSection||!modeTitles[mode])return;
	    toolsSection.style.display='block';
	    toolsSection.classList.remove('bc-tools-hidden');
	    toolsSection.classList.add('bc-tools-visible');
	    modePanels.forEach(function(panel){
	      panel.classList.toggle('active',panel.id==='mode-'+mode);
	    });
	    if(toolTitle)toolTitle.textContent=modeTitles[mode];
	    var target=document.getElementById('mode-'+mode);
	    if(target&&target.querySelector('textarea')){
	      setTimeout(function(){target.querySelector('textarea').focus();},0);
	    }
	    toolsSection.scrollIntoView({behavior:'smooth',block:'start'});
	  }
	  function hideModes(){
	    if(!toolsSection)return;
	    toolsSection.classList.remove('bc-tools-visible');
	    toolsSection.classList.add('bc-tools-hidden');
	    toolsSection.style.display='none';
	    modePanels.forEach(function(panel){panel.classList.remove('active');});
	    var launcher=document.querySelector('.mode-launcher-section');
	    if(launcher)launcher.scrollIntoView({behavior:'smooth',block:'start'});
	  }
	  document.querySelectorAll('[data-mode-trigger]').forEach(function(trigger){
	    trigger.addEventListener('click',function(e){
	      var mode=trigger.getAttribute('data-mode-trigger');
	      if(modeTitles[mode]){
	        e.preventDefault();
	        showMode(mode);
	      }
	    });
	  });
	  if(backBtn){
	    backBtn.addEventListener('click',function(e){
	      e.preventDefault();
	      hideModes();
	    });
	  }
	  if(location.hash==='#mode-quick'||location.hash==='#mode-quick-trigger')showMode('quick');
	  if(location.hash==='#mode-bundle'||location.hash==='#mode-bundle-trigger')showMode('bundle');

	  // ===== Form Submission (AJAX) =====
  function newGenerationRequestKey(){
    if(window.crypto&&typeof window.crypto.randomUUID==='function')return window.crypto.randomUUID();
    return 'browser-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)+Math.random().toString(36).slice(2);
  }
  document.querySelectorAll('.gen-form').forEach(function(form){
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var mode=form.getAttribute('data-mode');
      var btn=form.querySelector('.gen-btn');
      var skel=mode==='quick'?form.closest('.mode-panel').querySelector('.loading-skeleton'):null;
      var resArea=mode==='quick'?form.closest('.mode-panel').querySelector('.results-area-quick'):
                   form.closest('.mode-panel').querySelector('.results-area-bundle');
      btn.disabled=true;btn.textContent='⏳';
      if(skel)skel.style.display='block';
      if(resArea)resArea.innerHTML='';

      var d=new URLSearchParams();
      var requestKeyInput=form.querySelector('input[name="idempotencyKey"]');
      if(requestKeyInput)d.append('idempotencyKey',requestKeyInput.value);
      if(mode==='quick'){
        d.append('productDescription',document.getElementById('quickProduct').value);
        d.append('contentType',document.getElementById('quickContentType').value);
        d.append('tone',document.getElementById('quickTone').value);
        d.append('generationType','quick');
      } else if(mode==='bundle'){
        d.append('productDescription',document.getElementById('bundleProduct').value);
        var aud=document.getElementById('bundleTargetAudience');
        d.append('targetAudience',aud.value==='Custom'?document.querySelector('#bundle-audience-custom textarea').value:aud.value);
        var tone=document.getElementById('bundleVoice');
        d.append('tone',tone.value);
        var checked=[];
        document.querySelectorAll('#mode-bundle input[name="assets"]:checked').forEach(function(cb){checked.push(cb.value);});
        d.append('assets',checked.join(','));
        d.append('generationType','bundle');
      }

      fetch('/dashboard/generate',{
        method:'POST',
        headers:window.CopyQuickCsrf.headers({'Content-Type':'application/x-www-form-urlencoded','Accept':'application/json'}),
        body:d.toString()
      })
      .then(function(r){return r.json().then(function(d){
        if(!r.ok){
          if(d.retryWithNewRequestKey&&requestKeyInput)requestKeyInput.value=newGenerationRequestKey();
          throw new Error(d.error||'Failed');
        }
        return d;
      });})
      .then(function(d){
        btn.disabled=false;btn.textContent=mode==='quick'?'Generate':'📦 Generate Bundle';
        if(skel)skel.style.display='none';
        window.CopyQuickDashboardResults.renderGenerationResults(resArea,d.results);
        if(requestKeyInput)requestKeyInput.value=newGenerationRequestKey();
      }).catch(function(e){
        btn.disabled=false;btn.textContent=mode==='quick'?'Generate':'📦 Generate Bundle';
        if(skel)skel.style.display='none';
        window.CopyQuickDashboardResults.renderError(resArea,e.message);
      });
    });
  });

  // Copy function
  window.copyText=function(t,b){
    navigator.clipboard.writeText(t).then(function(){
      b.classList.add('copied');b.innerHTML='✅ <span>Copied!</span>';
      setTimeout(function(){b.classList.remove('copied');b.innerHTML='📋 <span>Copy</span>';},2000);
    });
  };

  document.querySelectorAll('.server-copy-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      window.copyText(btn.getAttribute('data-copy-text') || '',btn);
    });
  });

  // Fade-in
  var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:0.1});
  document.querySelectorAll('.fade-in').forEach(function(e){o.observe(e);});
})();
</script>
