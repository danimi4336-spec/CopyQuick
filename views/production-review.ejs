<div class="production-review-page">
    <div class="container production-review-container">
        <header class="production-review-header">
            <span class="build-plan-eyebrow">Final Production Review</span>
            <h1>Review what CopyQuick will create</h1>
            <p>Confirm your finished work, included supporting documents, and exact cost before Production begins.</p>
        </header>

        <% if (error) { %><div class="alert alert-error production-review-alert" role="alert"><%= error %></div><% } %>

        <section class="production-readiness-card" aria-labelledby="production-readiness-title">
            <div>
                <span>Plan readiness</span>
                <h2 id="production-readiness-title"><%= cost.canAfford ? (readyToUseAssets.length ? 'Ready to start' : 'Planning work ready to start') : 'Action needed before Production' %></h2>
                <p><% if (cost.canAfford) { %>CopyQuick will create the selected work shown below when you start Production.<% } else { %><%= cost.blockingReason %><% } %></p>
            </div>
            <dl>
                <div><dt>Finished assets</dt><dd><%= readyToUseAssets.length %></dd></div>
                <div><dt>Supporting documents</dt><dd><%= planningFoundation.length %></dd></div>
            </dl>
        </section>

        <section class="production-cost-card" aria-labelledby="production-cost-title">
            <div>
                <span>Authoritative production cost</span>
                <h2 id="production-cost-title"><%= cost.productionUnitCount %> production credit<%= cost.productionUnitCount === 1 ? '' : 's' %></h2>
                <p>Only ready-to-use assets use Production credits. <%= cost.planningFoundationCount %> supporting document<%= cost.planningFoundationCount === 1 ? '' : 's' %> will be prepared at no additional Production-credit cost.</p>
            </div>
            <dl>
                <div><dt>Current usage</dt><dd><%= cost.currentUsage %></dd></div>
                <div><dt>Monthly allowance</dt><dd><%= cost.monthlyAllowance %></dd></div>
                <div><dt>Available before production</dt><dd><%= cost.remainingAllowance %></dd></div>
                <div><dt>Available after production</dt><dd><%= Math.max(cost.remainingAllowance - cost.productionUnitCount, 0) %></dd></div>
            </dl>
        </section>

        <section class="deliverable-display-section deliverable-output-section" aria-labelledby="production-review-plan-title">
            <header><div><span class="build-plan-eyebrow">Your finished work</span><h2 id="production-review-plan-title">What you'll receive</h2></div><strong><%= readyToUseAssets.length %> ready asset<%= readyToUseAssets.length === 1 ? '' : 's' %></strong></header>
            <% if (readyToUseAssets.length) { %><p>These assets will be ready for your review after Production completes. <%= batch.completed.length %> completed step<%= batch.completed.length === 1 ? '' : 's' %> will not be repeated.</p><% } else { %><p>This plan contains supporting work only; no ready-to-use asset is included.</p><% } %>
            <ol class="deliverable-display-list">
                <% readyToUseAssets.forEach(function(item, index) { %>
                    <li><span class="production-job-order"><%= index + 1 %></span><div><strong><%= item.title %></strong><small>Ready for review after Production completes · 1 Production credit</small><p><%= item.reason %></p></div></li>
                <% }); %>
            </ol>
        </section>

        <% if (planningFoundation.length) { %>
            <details class="planning-foundation-disclosure">
                <summary><span>Supporting work</span><small><%= planningFoundation.length %> supporting document<%= planningFoundation.length === 1 ? '' : 's' %> · included free</small></summary>
                <div class="planning-foundation-content">
                    <p>CopyQuick prepares these documents to guide and validate the finished work. They are included at no additional Production-credit cost.</p>
                    <ol class="deliverable-display-list">
                        <% planningFoundation.forEach(function(item, index) { %>
                            <li><span class="production-job-order"><%= index + 1 %></span><div><strong><%= item.title %></strong><small><% if (item.id === 'research_evidence_pack') { %>Research &amp; Sources<% } else { %>Supporting document<% } %> · included free</small><p><%= item.reason %></p></div></li>
                        <% }); %>
                    </ol>
                </div>
            </details>
        <% } %>

        <% if (batch.completed.length || batch.deferred.length) { %>
            <section class="production-review-status" aria-label="Plan progress and deferred work">
                <% if (batch.completed.length) { %><div><h2>Already completed</h2><ul><% batch.completed.forEach(function(item) { %><li><%= item.title %></li><% }); %></ul><p>These are reused without another generation charge.</p></div><% } %>
                <% if (batch.deferred.length) { %><div><h2>Saved for later</h2><ul><% batch.deferred.forEach(function(item) { %><li><%= item.title %></li><% }); %></ul><p>Return to this plan after the current batch is complete.</p></div><% } %>
            </section>
        <% } %>

        <% if (cost.canAfford) { %>
            <div class="production-confirmation">
                <p>Starting this run will use <strong><%= cost.productionUnitCount %></strong> Production credit<%= cost.productionUnitCount === 1 ? '' : 's' %> for <%= readyToUseAssets.length %> ready-to-use asset<%= readyToUseAssets.length === 1 ? '' : 's' %>. Supporting work is included at no additional Production-credit cost. Usage begins when you select Start Production.</p>
                <div class="production-confirmation-actions">
                    <a href="/discovery/production-ready" class="btn btn-outline">← Back</a>
                    <form action="/production/start" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-primary">Start Production</button></form>
                </div>
            </div>
        <% } else { %>
            <div class="production-confirmation blocked">
                <p><%= cost.blockingReason %></p>
                <div><a href="/discovery/production-ready" class="btn btn-outline">← Back</a> <a href="/discovery/build-plan" class="btn btn-outline">Choose an Affordable Batch</a> <a href="/pricing?returnTo=%2Fproduction%2Freview" class="btn btn-primary">View Plans</a></div>
            </div>
        <% } %>
    </div>
</div>
