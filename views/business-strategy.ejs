<div class="strategy-page">
    <div class="container strategy-container">
        <header class="strategy-header">
            <span class="strategy-eyebrow">Strategic Foundation</span>
            <h1>Recommended Business Strategy</h1>
            <p>Built from the business understanding you confirmed. This foundation will guide future planning and recommendations.</p>
            <span class="strategy-confidence"><%= strategyResult.status || strategyResult.confidence %></span>
        </header>

        <% if (error) { %><div class="alert alert-error strategy-alert" role="alert"><%= error %></div><% } %>

        <% const sections = [
            ...(strategyResult.strategy.businessObjective ? [['businessObjective', objective === 'improve_search_rankings' ? 'Business & Search Objective' : 'Business Objective']] : []),
            ['marketPosition', 'Market Position'],
            ['primaryCustomer', 'Primary Customer'],
            ['customerMotivation', 'Customer Motivation'],
            ['competitiveApproach', 'Competitive Approach'],
            ['pricingPosition', 'Pricing Position'],
            ['primarySalesChannel', objective === 'get_more_customers' ? 'Current Acquisition Source' : objective === 'increase_conversion_rates' ? 'Current Traffic Source' : objective === 'improve_search_rankings' ? 'Search Channel Context' : 'Primary Sales Channel'],
            ['communicationStyle', 'Communication Style'],
            ['marketingFocus', 'Marketing Focus'],
            ['launchApproach', objective === 'get_more_customers' ? 'Recommended Acquisition Direction' : objective === 'increase_conversion_rates' ? 'Conversion Testing Approach' : objective === 'improve_search_rankings' ? 'Search Execution Approach' : 'Launch Strategy'],
            ['risks', 'Strategic Risks']
        ]; %>
        <div class="strategy-grid">
            <% sections.forEach(function(entry) { const item = strategyResult.strategy[entry[0]]; %>
                <section class="strategy-card">
                    <div class="strategy-card-heading">
                        <h2><%= entry[1] %></h2>
                        <span><%= item.confidence %></span>
                    </div>
                    <% if (Array.isArray(item.value)) { %>
                        <ul class="strategy-risk-list">
                            <% item.value.forEach(function(risk) { %><li><%= risk %></li><% }); %>
                        </ul>
                    <% } else { %>
                        <p class="strategy-value"><%= item.value %></p>
                    <% } %>
                    <% if (item.semanticRole === 'strategic_recommendation') { %>
                        <span class="strategy-semantic-role"><%= entry[0] === 'marketPosition' ? 'Recommended Direction' : 'Strategic Recommendation' %></span>
                    <% } %>
                    <div class="strategy-why">
                        <strong>Why</strong>
                        <p><%= item.explanation %></p>
                    </div>
                </section>
            <% }); %>
        </div>

        <% if (strategyResult.assumptions.length) { %>
            <section class="strategy-supporting-card">
                <h2>Assumptions to keep in view</h2>
                <ul><% strategyResult.assumptions.forEach(function(assumption) { %><li><%= assumption %></li><% }); %></ul>
            </section>
        <% } %>

        <% if (strategyResult.recommendations.length) { %>
            <section class="strategy-supporting-card strategy-recommendations">
                <h2>Areas that may improve your strategy</h2>
                <div class="strategy-recommendation-list">
                    <% strategyResult.recommendations.forEach(function(item) { %>
                        <article>
                            <h3><%= item.recommendation %></h3>
                            <p><strong>Why:</strong> <%= item.reason %></p>
                        </article>
                    <% }); %>
                </div>
            </section>
        <% } %>

        <div class="strategy-actions">
            <a href="/discovery/reflection" class="btn btn-outline">← Back</a>
            <% if (canBuildPlan) { %>
                <a href="/discovery/build-plan" class="btn btn-primary">Continue to Build Plan</a>
            <% } else { %>
                <button type="button" class="btn btn-primary" disabled aria-disabled="true">Continue to Build Plan</button>
            <% } %>
        </div>
    </div>
</div>
