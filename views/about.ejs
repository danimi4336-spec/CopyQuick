<section class="page-hero">
    <div class="container">
        <h1>About CopyQuick</h1>
        <p class="tagline">We believe great marketing shouldn't require a professional writer. CopyQuick puts the power of AI-powered copywriting into everyone's hands.</p>
    </div>
</section>

<section class="mission-section">
    <div class="container">
        <div class="mission-content fade-in">
            <h2 class="section-title">Our Mission</h2>
            <p>To democratize high-converting marketing copy. Every solopreneur, founder, and small business owner deserves access to copy that converts — without spending hours staring at a blank page or paying hundreds of dollars per hour for a copywriter.</p>
        </div>
    </div>
</section>

<section class="story-section">
    <div class="container">
        <h2 class="section-title fade-in">Why We Built CopyQuick</h2>
        <div class="story-grid">
            <div class="story-card fade-in">
                <div class="story-icon">⏱️</div>
                <h3>The Time Problem</h3>
                <p>Writing marketing copy takes hours. Solopreneurs don't have that kind of time. We built CopyQuick to turn minutes into seconds.</p>
            </div>
            <div class="story-card fade-in">
                <div class="story-icon">💰</div>
                <h3>The Cost Problem</h3>
                <p>Professional copywriters charge $100–$300/hour. Most startups can't afford that for every tweet, email, or ad. CopyQuick delivers 90% of the quality at 1% of the cost.</p>
            </div>
            <div class="story-card fade-in">
                <div class="story-icon">🧠</div>
                <h3>The Blank Page Problem</h3>
                <p>There's nothing more intimidating than a blinking cursor. We removed the friction — just describe your product and get 5 ready-to-use variations instantly.</p>
            </div>
        </div>
    </div>
</section>

<section class="content-types-section">
    <div class="container">
        <h2 class="section-title fade-in">Marketing Content You Can Create</h2>
        <p class="section-subtitle fade-in">CopyQuick generates copy for every channel your business needs.</p>
        <div class="content-types-grid">
    <% 
        const icons = { subject_line: '✉️', social_post: '📱', ad_headline: '📢', product_description: '🛒', cta: '🎯', email_campaign: '📧', blog_intro: '📝', sales_message: '💬' };
        const descs = { 
            subject_line: 'High open-rate subject lines for campaigns, newsletters, and promotions.',
            social_post: 'Engaging posts for Twitter, LinkedIn, Instagram, and Facebook.',
            ad_headline: 'Facebook Ads, Google Ads, LinkedIn Sponsored — headlines that convert.',
            product_description: 'Amazon listings, Shopify products, and ecommerce descriptions.',
            cta: 'CTAs that drive clicks and conversions, tailored to your audience.',
            email_campaign: 'Full email sequences — welcome flows, promotions, and follow-ups.',
            blog_intro: 'Strong openings that hook readers and keep them scrolling.',
            sales_message: 'Direct messages, cold emails, and outreach copy that gets replies.'
        };
        Object.keys(contentTypes).forEach(function(key) { 
    %>
        <div class="content-type-card fade-in">
            <span class="type-icon"><%= icons[key] || '📄' %></span>
            <h3><%= contentTypes[key] %></h3>
            <p><%= descs[key] || 'AI-powered copy for your marketing needs.' %></p>
        </div>
    <% }); %>
</div>
    </div>
</section>

<section class="vision-section">
    <div class="container">
        <div class="vision-content fade-in">
            <h2 class="section-title">Our Vision</h2>
            <p>We envision a world where every small business owner, creator, and entrepreneur has access to the same quality of marketing copy as enterprise companies — without the enterprise price tag. CopyQuick is the first step toward that future, and we're just getting started.</p>
        </div>
    </div>
</section>

<section class="cta-bottom">
    <div class="container">
        <h2 class="fade-in">Ready to create better copy in seconds?</h2>
        <a href="/signup" class="btn btn-primary btn-lg fade-in">Start Generating for Free</a>
    </div>
</section>

<script>
(function() {
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.fade-in').forEach(function(el) {
        observer.observe(el);
    });
})();
</script>