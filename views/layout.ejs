<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✍️</text></svg>">
</head>
<body>
    <!-- Top Nav -->
    <nav class="navbar">
        <div class="container">
            <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">☰</button>
            <a href="/" class="logo">CopyQuick</a>
            <div class="nav-right">
                <% if (locals.user) { %>
                    <a href="/dashboard" class="nav-link">Dashboard</a>
                    <a href="/profile" class="nav-link"><%= user.name || 'Profile' %></a>
                    <form action="/logout" method="POST" style="display:inline;">
                        <button type="submit" class="btn-link nav-link">Logout</button>
                    </form>
                <% } else { %>
                    <a href="/login" class="nav-link">Login</a>
                    <a href="/signup" class="btn btn-primary" style="padding:0.45rem 1rem;font-size:0.85rem;">Get Started</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <% if (locals.user) { %>
    <aside class="sidebar" id="sidebar">
        <nav class="sidebar-nav">
            <a href="/dashboard" class="sidebar-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
                <span class="sidebar-icon">📊</span> Dashboard
            </a>
            <a href="/brand-brain" class="sidebar-link <%= currentPage === 'brand-brain' ? 'active' : '' %>">
                <span class="sidebar-icon">🧠</span> Brand Brain™
            </a>
            <a href="/campaign-studio" class="sidebar-link <%= currentPage === 'campaign-studio' ? 'active' : '' %>">
                <span class="sidebar-icon">🚀</span> Campaign Studio™
            </a>
            <a href="/history" class="sidebar-link <%= currentPage === 'history' ? 'active' : '' %>">
                <span class="sidebar-icon">📜</span> History
            </a>
            <a href="/favorites" class="sidebar-link <%= currentPage === 'favorites' ? 'active' : '' %>">
                <span class="sidebar-icon">⭐</span> Favorites
            </a>
            <div class="sidebar-divider"></div>
            <a href="/profile" class="sidebar-link <%= currentPage === 'profile' ? 'active' : '' %>">
                <span class="sidebar-icon">⚙️</span> Settings
            </a>
        </nav>
    </aside>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <% } %>

    <!-- Main Content -->
    <main class="main-content <%= locals.user ? 'has-sidebar' : '' %>">
        <%- body %>
    </main>

    <!-- Footer (only for public pages) -->
    <% if (!locals.user) { %>
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <h3>CopyQuick</h3>
                    <p>AI-powered marketing platform. Generate content and campaigns for your business instantly.</p>
                </div>
                <div class="footer-col">
                    <h4>Product</h4>
                    <ul>
                        <li><a href="/#features">Features</a></li>
                        <li><a href="/#pricing">Pricing</a></li>
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/signup">Get Started</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                        <li><a href="/blog">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/privacy">Privacy Policy</a></li>
                        <li><a href="/terms">Terms of Service</a></li>
                        <li><a href="/cookies">Cookie Policy</a></li>
                        <li><a href="/refunds">Refund Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 CopyQuick. All rights reserved.</p>
                <div class="footer-social">
                    <a href="#" aria-label="Twitter">𝕏</a>
                    <a href="#" aria-label="LinkedIn">in</a>
                    <a href="#" aria-label="GitHub">⌂</a>
                </div>
            </div>
        </div>
    </footer>
    <% } %>

    <script>
    // Sidebar toggle
    (function(){
        var toggle = document.getElementById('sidebarToggle');
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');
        if (toggle && sidebar) {
            toggle.addEventListener('click', function() {
                sidebar.classList.toggle('open');
                if (overlay) overlay.classList.toggle('visible');
            });
            if (overlay) overlay.addEventListener('click', function() {
                sidebar.classList.remove('open');
                overlay.classList.remove('visible');
            });
        }
    })();
    </script>
</body>
</html>