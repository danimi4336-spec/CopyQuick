<!DOCTYPE html>
<html lang="en">
<head>
    <% const metadata = typeof pageMetadata !== 'undefined' && pageMetadata ? pageMetadata : { robots: 'noindex, nofollow, noarchive' }; %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= metadata.title || title %></title>
    <meta name="robots" content="<%= metadata.robots %>">
    <% if (metadata.description) { %><meta name="description" content="<%= metadata.description %>"><% } %>
    <% if (metadata.canonicalUrl) { %>
    <link rel="canonical" href="<%= metadata.canonicalUrl %>">
    <meta property="og:site_name" content="CopyQuick">
    <meta property="og:type" content="<%= metadata.type %>">
    <meta property="og:title" content="<%= metadata.title %>">
    <meta property="og:description" content="<%= metadata.description %>">
    <meta property="og:url" content="<%= metadata.canonicalUrl %>">
    <meta property="og:image" content="<%= metadata.imageUrl %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= metadata.imageAlt %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= metadata.title %>">
    <meta name="twitter:description" content="<%= metadata.description %>">
    <meta name="twitter:image" content="<%= metadata.imageUrl %>">
    <meta name="twitter:image:alt" content="<%= metadata.imageAlt %>">
    <% } %>
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" href="/images/copyquick-favicon.svg" type="image/svg+xml">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <!-- Top Nav -->
    <nav class="navbar" aria-label="Primary navigation">
        <div class="container">
            <% if (locals.user) { %><button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Open navigation menu" aria-controls="sidebar" aria-expanded="false">☰</button><% } %>
            <a href="/" class="logo">CopyQuick</a>
            <div class="nav-right">
                <% if (locals.user) { %>
                    <a href="/dashboard" class="nav-link">Dashboard</a>
                    <a href="/profile" class="nav-link"><%= user.name || 'Profile' %></a>
                    <form action="/logout" method="POST" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-link nav-link">Logout</button>
                    </form>
                <% } else { %>
                    <a href="/login" class="nav-link">Login</a>
                    <a href="/signup" class="btn btn-primary" style="padding:0.45rem 1rem;font-size:0.85rem;">Get Started</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <% if (locals.user) { %>
    <aside class="sidebar" id="sidebar" aria-label="Workspace navigation">
        <nav class="sidebar-nav" aria-label="Workspace">
            <a href="/dashboard" class="sidebar-link <%= currentPage === 'dashboard' ? 'active' : '' %>" <%- currentPage === 'dashboard' ? 'aria-current="page"' : '' %>>
                <span class="sidebar-icon" aria-hidden="true">📊</span> Dashboard
            </a>
            <a href="/brand-brain" class="sidebar-link <%= currentPage === 'brand-brain' ? 'active' : '' %>" <%- currentPage === 'brand-brain' ? 'aria-current="page"' : '' %>>
                <span class="sidebar-icon" aria-hidden="true">🧠</span> Brand Brain™
            </a>
            <a href="/welcome" class="sidebar-link <%= currentPage === 'welcome' ? 'active' : '' %>" <%- currentPage === 'welcome' ? 'aria-current="page"' : '' %>>
                <span class="sidebar-icon" aria-hidden="true">🚀</span> Start an Objective
            </a>
            <a href="/production" class="sidebar-link <%= currentPage === 'production' ? 'active' : '' %>" <%- currentPage === 'production' ? 'aria-current="page"' : '' %>>
                <span class="sidebar-icon" aria-hidden="true">📋</span> Production Plans
            </a>
            <a href="/history" class="sidebar-link <%= currentPage === 'history' ? 'active' : '' %>" <%- currentPage === 'history' ? 'aria-current="page"' : '' %>>
                <span class="sidebar-icon" aria-hidden="true">📜</span> History
            </a>
            <a href="/favorites" class="sidebar-link <%= currentPage === 'favorites' ? 'active' : '' %>" <%- currentPage === 'favorites' ? 'aria-current="page"' : '' %>>
                <span class="sidebar-icon" aria-hidden="true">⭐</span> Favorites
            </a>
            <div class="sidebar-divider"></div>
            <a href="/profile" class="sidebar-link <%= currentPage === 'profile' ? 'active' : '' %>" <%- currentPage === 'profile' ? 'aria-current="page"' : '' %>>
                <span class="sidebar-icon" aria-hidden="true">⚙️</span> Settings
            </a>
        </nav>
    </aside>
    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
    <% } %>

    <!-- Main Content -->
    <main id="main-content" class="main-content <%= locals.user ? 'has-sidebar' : '' %>" tabindex="-1">
        <%- body %>
    </main>

    <!-- Footer (only for public pages) -->
    <% if (!locals.user) { %>
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <h3>CopyQuick</h3>
                    <p>Guided marketing planning and customer-ready content for builders and small businesses.</p>
                </div>
                <div class="footer-col">
                    <h4>Product</h4>
                    <ul>
                        <li><a href="/#features">Features</a></li>
                        <li><a href="/#pricing">Pricing</a></li>
                        <li><a href="/signup">Get Started</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/privacy">Privacy Policy</a></li>
                        <li><a href="/terms">Terms of Service</a></li>
                        <li><a href="/cookies">Cookie Policy</a></li>
                        <li><a href="/refunds">Refund Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 CopyQuick. All rights reserved.</p>
            </div>
        </div>
    </footer>
    <% } %>

    <script>
    window.CopyQuickCsrf = (function(){
        var meta = document.querySelector('meta[name="csrf-token"]');
        var token = meta ? meta.getAttribute('content') : '';
        return {
            token: token,
            headers: function(headers) {
                var merged = {};
                Object.keys(headers || {}).forEach(function(key) { merged[key] = headers[key]; });
                if (token) merged['X-CSRF-Token'] = token;
                return merged;
            }
        };
    })();

    // Server-rendered errors are announced and receive focus after
    // navigation so keyboard and screen-reader users land on the failure
    // context before correcting the form.
    (function(){
        var errorAlert = document.querySelector('.alert-error[role="alert"]');
        if (!errorAlert) return;
        if (!errorAlert.hasAttribute('tabindex')) errorAlert.setAttribute('tabindex', '-1');
        errorAlert.focus();
    })();

    // Sidebar toggle
    (function(){
        var toggle = document.getElementById('sidebarToggle');
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');
        if (toggle && sidebar) {
            function setSidebarOpen(open, restoreFocus) {
                sidebar.classList.toggle('open', open);
                if (overlay) overlay.classList.toggle('visible', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
                if (open) {
                    var firstLink = sidebar.querySelector('a[href]');
                    if (firstLink) firstLink.focus();
                } else if (restoreFocus) {
                    toggle.focus();
                }
            }
            toggle.addEventListener('click', function() {
                setSidebarOpen(toggle.getAttribute('aria-expanded') !== 'true', false);
            });
            if (overlay) overlay.addEventListener('click', function() {
                setSidebarOpen(false, true);
            });
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
                    setSidebarOpen(false, true);
                }
            });
        }
    })();
    </script>
</body>
</html>
