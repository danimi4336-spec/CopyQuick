<div class="objective-universe-page">
    <div class="container objective-universe-container">
        <header class="objective-universe-header fade-in">
            <span class="objective-eyebrow">Your business, moving forward</span>
            <h1>What do you want to accomplish?</h1>
            <p>Choose your priority. CopyQuick will help you turn it into a clear plan and the work needed to execute it.</p>
        </header>

        <form action="/welcome" method="POST" class="objective-universe-form fade-in">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="objective-grid" aria-label="Business objectives">
                <% objectives.forEach(function(objective) { %>
                    <button type="submit" name="goal" value="<%= objective.id %>" class="objective-card" aria-describedby="objective-summary-<%= objective.id %> objective-outcome-<%= objective.id %>">
                        <span class="objective-icon" aria-hidden="true"><%= objective.icon %></span>
                        <span class="objective-card-content">
                            <span class="objective-card-title"><%= objective.title %></span>
                            <span class="objective-card-description" id="objective-summary-<%= objective.id %>"><%= objective.description %></span>
                            <span class="objective-card-outcome" id="objective-outcome-<%= objective.id %>"><%= objective.outcome %></span>
                        </span>
                        <span class="objective-arrow" aria-hidden="true">→</span>
                    </button>
                <% }); %>
            </div>
            <p class="objective-assurance">You can change direction and explore other objectives from your Builder at any time.</p>
        </form>
    </div>
</div>

<script>
(function(){
  if (!('IntersectionObserver' in window)) {
    document.querySelectorAll('.fade-in').forEach(function(el){ el.classList.add('visible'); });
    return;
  }
  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){ if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(function(el){ observer.observe(el); });
})();
</script>
