<div class="welcome-page">
    <div class="container">
        <div class="welcome-header fade-in">
            <h1>Welcome to CopyQuick</h1>
            <p class="welcome-sub">Let's build something extraordinary together. What would you like to build today?</p>
        </div>
        <form action="/welcome" method="POST" class="welcome-form fade-in">
            <div class="welcome-grid">
                <label class="welcome-card">
                    <input type="radio" name="goal" value="launch_product" class="welcome-radio" required>
                    <span class="welcome-icon">🚀</span>
                    <span class="welcome-card-title">Launch a New Product</span>
                    <span class="welcome-card-desc">Generate copy for your product launch across all channels</span>
                </label>
                <label class="welcome-card">
                    <input type="radio" name="goal" value="grow_business" class="welcome-radio">
                    <span class="welcome-icon">📈</span>
                    <span class="welcome-card-title">Grow My Existing Business</span>
                    <span class="welcome-card-desc">Create marketing content to attract more customers</span>
                </label>
                <label class="welcome-card">
                    <input type="radio" name="goal" value="start_store" class="welcome-radio">
                    <span class="welcome-icon">🛒</span>
                    <span class="welcome-card-title">Start an Online Store</span>
                    <span class="welcome-card-desc">Build product descriptions, ads, and email campaigns</span>
                </label>
                <label class="welcome-card">
                    <input type="radio" name="goal" value="promote_service" class="welcome-radio">
                    <span class="welcome-icon">💼</span>
                    <span class="welcome-card-title">Promote My Service</span>
                    <span class="welcome-card-desc">Create compelling copy for your service-based business</span>
                </label>
                <label class="welcome-card">
                    <input type="radio" name="goal" value="build_brand" class="welcome-radio">
                    <span class="welcome-icon">✨</span>
                    <span class="welcome-card-title">Build My Brand</span>
                    <span class="welcome-card-desc">Establish your brand voice across all marketing touchpoints</span>
                </label>
                <label class="welcome-card">
                    <input type="radio" name="goal" value="campaigns" class="welcome-radio">
                    <span class="welcome-icon">📢</span>
                    <span class="welcome-card-title">Generate Marketing Campaigns</span>
                    <span class="welcome-card-desc">Create complete multi-channel campaigns from one idea</span>
                </label>
                <label class="welcome-card welcome-card-wide">
                    <input type="radio" name="goal" value="other" class="welcome-radio">
                    <span class="welcome-icon">💡</span>
                    <span class="welcome-card-title">Something Else</span>
                    <span class="welcome-card-desc">I'll figure it out as I go</span>
                </label>
            </div>
            <div class="welcome-submit">
                <button type="submit" class="btn btn-primary btn-lg">Let's Get Started →</button>
            </div>
        </form>
    </div>
</div>

<style>
.welcome-page{padding:4rem 0;text-align:center;min-height:80vh;display:flex;align-items:center;}
.welcome-header{margin-bottom:3rem;}
.welcome-header h1{font-size:2.75rem;margin-bottom:0.75rem;}
.welcome-sub{font-size:1.15rem;color:var(--secondary);max-width:550px;margin:0 auto;}
.welcome-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;max-width:750px;margin:0 auto;}
.welcome-card{display:flex;flex-direction:column;align-items:center;gap:0.35rem;padding:1.75rem 1.25rem;border:2px solid var(--border);border-radius:1.25rem;cursor:pointer;transition:all 0.2s;background:var(--white);text-align:center;}
.welcome-card:hover{border-color:var(--primary);box-shadow:var(--shadow);}
.welcome-card:has(input:checked){border-color:var(--primary);background:var(--primary-light);box-shadow:0 0 0 3px rgba(79,70,229,0.15);}
.welcome-radio{position:absolute;opacity:0;pointer-events:none;}
.welcome-icon{font-size:2rem;margin-bottom:0.25rem;}
.welcome-card-title{font-size:0.95rem;font-weight:700;color:var(--dark);}
.welcome-card-desc{font-size:0.8rem;color:var(--secondary);max-width:none;line-height:1.4;}
.welcome-card-wide{grid-column:1/-1;flex-direction:row;padding:1rem 1.5rem;text-align:left;}
.welcome-card-wide .welcome-icon{font-size:1.5rem;margin-bottom:0;}
.welcome-submit{margin-top:2.5rem;}
@media(max-width:768px){
  .welcome-grid{grid-template-columns:1fr;max-width:400px;}
  .welcome-header h1{font-size:2rem;}
}
</style>
<script>
(function(){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:0.1});document.querySelectorAll('.fade-in').forEach(function(e){o.observe(e);});})();
</script>