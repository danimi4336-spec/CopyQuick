<div class="auth-container"><div class="auth-card">
    <h2>Reset your password</h2>
    <p>Enter your account email. We’ll send a secure link if an account is available.</p>
    <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
    <form action="/forgot-password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group"><label for="resetEmail">Email Address</label>
        <input type="email" id="resetEmail" name="email" required maxlength="254"></div>
        <button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>
    </form>
    <p class="auth-footer"><a href="/login">Back to login</a></p>
</div></div>
