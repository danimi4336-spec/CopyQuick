<div class="container campaign-page">
    <div class="campaign-hero fade-in">
        <span class="hero-badge">🚀 Campaign Studio™</span>
        <h1>Build a Complete Campaign</h1>
        <p class="text-secondary">Generate an entire multi-channel marketing campaign from a single product description.</p>
    </div>

    <div class="campaign-setup-card fade-in">
        <div class="campaign-setup-header">
            <h2>Campaign Setup</h2>
            <span class="badge badge-pro">Coming in Build #3</span>
        </div>
        <div class="campaign-setup-body">
            <div class="form-group">
                <label>Campaign Goal</label>
                <select disabled><option>Select a goal...</option></select>
            </div>
            <div class="form-group">
                <label>Product / Service</label>
                <input type="text" disabled placeholder="Describe your product..." value="<% if (brain && brain.business_name) { %><%= brain.business_name %><% } %>">
            </div>
            <div class="form-group">
                <label>Target Audience</label>
                <select disabled>
                    <option><% if (brain && brain.target_audience) { %><%= brain.target_audience %><% } else { %>Select audience...<% } %></option>
                </select>
            </div>
            <div style="padding:2rem;text-align:center;background:var(--light);border-radius:1rem;margin-top:1rem;">
                <div style="font-size:3rem;margin-bottom:0.75rem;">🚀</div>
                <h3 style="margin-bottom:0.5rem;">Campaign Generation Coming Soon</h3>
                <p style="font-size:0.9rem;color:var(--secondary);max-width:none;">Your Brand Brain data will automatically power your campaigns.</p>
            </div>
            <button class="btn btn-primary btn-block btn-lg" disabled style="margin-top:1.25rem;opacity:0.5;">🚀 Generate Campaign</button>
        </div>
    </div>
</div>
<style>
.campaign-page{padding:3rem 0;max-width:700px;margin:0 auto;}
.campaign-hero{text-align:center;margin-bottom:2.5rem;}
.campaign-hero h1{margin-bottom:0.5rem;}
.campaign-setup-card{border:1px solid var(--border);border-radius:1.25rem;overflow:hidden;background:var(--white);}
.campaign-setup-header{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);background:var(--light);}
.campaign-setup-header h2{font-size:1.2rem;margin:0;}
.campaign-setup-body{padding:1.5rem;}
.campaign-setup-body .form-group{margin-bottom:1rem;}
.campaign-setup-body .form-group label{font-size:0.85rem;font-weight:600;margin-bottom:0.35rem;display:block;}
.campaign-setup-body .form-group select,.campaign-setup-body .form-group input{width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border);border-radius:0.75rem;font-size:0.9rem;font-family:inherit;background:var(--light);opacity:0.7;}
</style>
<script>
(function(){var o=new IntersectionObserver(function(e){e.forEach(function(e){if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:0.1});document.querySelectorAll('.fade-in').forEach(function(e){o.observe(e);});})();
</script>