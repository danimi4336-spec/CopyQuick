<% var regenerateRequestKey = typeof generationRequestKeys !== 'undefined' ? generationRequestKeys.regenerate : ''; %>
<% var productionRegenerateRequestKey = typeof generationRequestKeys !== 'undefined' ? generationRequestKeys.productionRegenerate : ''; %>
<div class="container workspace-page">
    <nav class="breadcrumb fade-in">
        <a href="/dashboard">Dashboard</a>
        <span>/</span>
        <% if (productionDeliverable && productionDeliverable.runId) { %><a href="/production/<%= productionDeliverable.runId %>">Production Plan</a><% } else { %><a href="/history">History</a><% } %>
        <span>/</span>
        <span><%= gen.title || gen.input_text.substring(0, 30) %></span>
    </nav>

    <div class="gen-detail-layout">
        <div class="gen-detail-main fade-in">
            <!-- Title -->
            <div class="gen-detail-header">
                <h1 class="gen-detail-title" id="genTitle"><%= gen.title || gen.input_text.substring(0, 50) %></h1>
                <div class="gen-detail-actions-top">
                    <button class="icon-btn <%= gen.favorite ? 'active' : '' %>" id="favBtn" onclick="toggleFav()" title="Favorite">⭐</button>
                    <% if (!productionDeliverable) { %><button class="icon-btn" onclick="deleteGen()" title="Delete">🗑️</button><% } %>
                </div>
            </div>

            <% if (!productionDeliverable) { %>
            <div class="detail-card">
                <h3>Prompt</h3>
                <p class="detail-prompt"><%= gen.input_text %></p>
            </div>
            <% } %>

            <!-- Results -->
            <div class="detail-card">
                <h3><%= productionDeliverable ? 'Production Deliverable' : 'Generated Content' %></h3>
                <div class="detail-results">
                    <% if (productionDeliverable && !productionDeliverable.customerReady) { %>
                        <div class="alert alert-info" role="status">This is a legacy planning outline, not a copy-ready deliverable. Create an improved AI version below to replace it with complete content.</div>
                    <% } %>
                    <% if (productionDeliverable && productionDeliverable.purposeNotice) { %>
                        <div class="alert alert-info production-purpose-notice" role="status">
                            <strong>Planning deliverable:</strong> <%= productionDeliverable.purposeNotice %>
                            <% if (productionDeliverable.nextDeliverable) { %>
                                <a href="/generation/<%= productionDeliverable.nextDeliverable.id %>">Open the ready-to-use email campaign →</a>
                            <% } %>
                        </div>
                    <% } %>
                    <% if (productionDeliverable && productionDeliverable.sections.length) { %>
                        <% productionDeliverable.sections.forEach(function(section, i) { %>
                            <section class="production-deliverable-section">
                                <div class="result-header"><h4><%= section.label %></h4><button class="copy-btn" onclick="copyText('<%= 'deliverable-' + i %>', this)" title="Copy">📋 Copy</button></div>
                                <% if (section.isList) { %><ul class="result-text" id="deliverable-<%= i %>"><% section.value.forEach(function(item) { %><li><%= item %></li><% }); %></ul>
                                <% } else { %><p class="result-text" id="deliverable-<%= i %>"><%= section.value %></p><% } %>
                            </section>
                        <% }); %>
                    <% } else if (!productionDeliverable) { %>
                    <% var resultsList = typeof results === 'string' ? JSON.parse(results) : results; %>
                    <% if (resultsList && resultsList.length) { %>
                        <% resultsList.forEach(function(r, i) { %>
                            <div class="detail-result-item">
                                <div class="result-header">
                                    <span class="result-tag"><%= r.tone %></span>
                                    <button class="copy-btn" onclick="copyText('<%= 'result-' + i %>', this)" title="Copy">📋 Copy</button>
                                </div>
                                <p class="result-text" id="result-<%= i %>"><%= r.text %></p>
                            </div>
                        <% }); %>
                    <% } %>
                    <% } %>
                </div>
            </div>

            <!-- Actions -->
            <div class="detail-actions-card">
                <% if (!productionDeliverable) { %><button class="btn btn-primary" onclick="regenerate()">🔄 Regenerate</button><% } %>
                <% if (productionDeliverable && productionDeliverable.canRegenerateWithAi) { %><button class="btn btn-primary" id="productionRegenerateBtn" data-artifact-role="<%= productionDeliverable.artifactRole || 'ready_to_use_asset' %>" onclick="regenerateProductionWithAi()"><%= productionDeliverable.artifactRole === 'planning_foundation' ? '✨ Regenerate Planning Foundation' : '✨ Create Improved AI Version' %></button><% } %>
                <% if (productionDeliverable && productionDeliverable.runId) { %><a href="/production/<%= productionDeliverable.runId %>" class="btn btn-primary">← Back to Production Plan</a><% } %>
                <a href="/generation/<%= gen.id %>/export?format=txt" class="btn btn-outline">📄 Export TXT</a>
                <a href="/generation/<%= gen.id %>/export?format=md" class="btn btn-outline">📝 Export MD</a>
                <% if (!productionDeliverable || productionDeliverable.customerReady) { %><button class="btn btn-outline" onclick="copyAll()">📋 Copy All</button><% } %>
            </div>
        </div>

        <aside class="gen-detail-sidebar fade-in">
            <div class="sidebar-card">
                <h3 class="h4">Metadata</h3>
                <div class="meta-list">
                    <div class="meta-row"><span class="meta-label">Type</span><span class="meta-value"><%= productionDeliverable && productionDeliverable.displayType ? productionDeliverable.displayType : gen.content_type.replace(/_/g, ' ') %></span></div>
                    <div class="meta-row"><span class="meta-label">Tone</span><span class="meta-value"><%= gen.tone %></span></div>
                    <div class="meta-row"><span class="meta-label">Words</span><span class="meta-value"><%= gen.word_count || 0 %></span></div>
                    <% if (productionDeliverable) { %>
                    <div class="meta-row"><span class="meta-label">Output Source</span><span class="meta-value"><%= productionDeliverable.source.label %></span></div>
                    <div class="meta-row"><span class="meta-label">Model</span><span class="meta-value"><%= productionDeliverable.source.model %></span></div>
                    <div class="meta-row"><span class="meta-label">Generation Method</span><span class="meta-value"><%= productionDeliverable.generationMethod %></span></div>
                    <% } else { %>
                    <div class="meta-row"><span class="meta-label">AI Model</span><span class="meta-value"><%= gen.ai_model || 'CopyQuick AI' %></span></div>
                    <% } %>
                    <div class="meta-row"><span class="meta-label">Created</span><span class="meta-value"><%= new Date(gen.created_at).toLocaleDateString() %></span></div>
                    <div class="meta-row"><span class="meta-label">Updated</span><span class="meta-value"><%= new Date(gen.updated_at || gen.created_at).toLocaleDateString() %></span></div>
                </div>
            </div>

            <div class="sidebar-card">
                <h3 class="h4">Tags</h3>
                <div class="tags-input-wrap">
                    <input type="text" id="tagInput" placeholder="Add tags..." value="<%= gen.tags || '' %>" onkeydown="handleTagKey(event)">
                    <button class="btn btn-primary btn-sm" onclick="saveTags()" style="margin-top:0.5rem;width:100%;">Save Tags</button>
                </div>
            </div>
        </aside>
    </div>
</div>

<script>
var genId = <%= gen.id %>;

function toggleFav() {
    fetch('/generation/' + genId + '/favorite', { method: 'POST', headers: window.CopyQuickCsrf.headers() })
        .then(r => r.json()).then(d => {
            var btn = document.getElementById('favBtn');
            btn.classList.toggle('active', d.favorite);
            showToast(d.favorite ? 'Added to favorites ⭐' : 'Removed from favorites');
        });
}

function deleteGen() {
    if (!confirm('Move to trash? You can restore within 30 days.')) return;
    fetch('/generation/' + genId + '/delete', { method: 'POST', headers: window.CopyQuickCsrf.headers() })
        .then(r => r.json()).then(function() {
            showToast('Deleted');
            setTimeout(function() { window.location.href = '/history'; }, 1000);
        });
}

var regenerateRequestKey = '<%= regenerateRequestKey %>';
var productionRegenerateRequestKey = '<%= productionRegenerateRequestKey %>';
function regenerate() {
    fetch('/generation/' + genId + '/regenerate', {
        method: 'POST',
        headers: window.CopyQuickCsrf.headers({
            'Accept': 'application/json',
            'Idempotency-Key': regenerateRequestKey
        })
    })
        .then(r => r.json()).then(function(d) {
            if (d.retryWithNewRequestKey && window.crypto && typeof window.crypto.randomUUID === 'function') {
                regenerateRequestKey = window.crypto.randomUUID();
            }
            if (d.error) { showToast('Error: ' + d.error); return; }
            showToast('Regenerated!');
            location.reload();
        });
}

function regenerateProductionWithAi() {
    var button = document.getElementById('productionRegenerateBtn');
    var planningDeliverable = button && button.dataset.artifactRole === 'planning_foundation';
    var confirmation = planningDeliverable
        ? 'Regenerate this planning foundation? This optional regeneration uses 1 generation credit and replaces the current planning document. It will not create customer-facing sales copy.'
        : 'Create a new AI version of this deliverable? This uses 1 generation credit and replaces the content shown on this page.';
    if (!confirm(confirmation)) return;
    if (button) { button.disabled = true; button.textContent = 'Creating AI version…'; }
    fetch('/generation/' + genId + '/regenerate-production', {
        method: 'POST',
        headers: window.CopyQuickCsrf.headers({
            'Accept': 'application/json',
            'Idempotency-Key': productionRegenerateRequestKey
        })
    }).then(function(response) {
        return response.json().then(function(body) { return { ok: response.ok, body: body }; });
    }).then(function(result) {
        if (!result.ok || result.body.error) {
            if (result.body.retryWithNewRequestKey && window.crypto && typeof window.crypto.randomUUID === 'function') {
                productionRegenerateRequestKey = window.crypto.randomUUID();
            }
            throw new Error(result.body.error || 'The AI version could not be created.');
        }
        showToast('Improved AI version created.');
        location.reload();
    }).catch(function(error) {
        showToast(error.message);
        if (button) { button.disabled = false; button.textContent = planningDeliverable ? '✨ Regenerate Planning Foundation' : '✨ Create Improved AI Version'; }
    });
}

function copyText(id, btn) {
    var text = document.getElementById(id).innerText;
    navigator.clipboard.writeText(text).then(function() {
        btn.textContent = '✅ Copied!';
        setTimeout(function() { btn.innerHTML = '📋 Copy'; }, 2000);
    });
}

function copyAll() {
    var texts = [];
    document.querySelectorAll('.result-text').forEach(function(el) { texts.push(el.innerText); });
    navigator.clipboard.writeText(texts.join('\n\n---\n\n')).then(function() {
        showToast('All copies copied to clipboard 📋');
    });
}

function handleTagKey(e) {
    if (e.key === 'Enter') { e.preventDefault(); saveTags(); }
}

function saveTags() {
    var tags = document.getElementById('tagInput').value;
    fetch('/generation/' + genId + '/tags', {
        method: 'POST',
        headers: window.CopyQuickCsrf.headers({ 'Content-Type': 'application/json' }),
        body: JSON.stringify({ tags: tags })
    }).then(r => r.json()).then(function() { showToast('Tags saved ✅'); });
}

function showToast(msg) {
    var existing = document.querySelector('.toast');
    if (existing) existing.remove();
    var toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(function() { toast.classList.add('show'); }, 10);
    setTimeout(function() { toast.classList.remove('show'); setTimeout(function() { toast.remove(); }, 300); }, 2500);
}

(function() {
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach(function(el) { observer.observe(el); });
})();
</script>
